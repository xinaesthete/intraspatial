  .pt-doc .dim-others .cell:not(.hot):not(.warm),
  .pt-doc .dim-others .selblock:not(.hot):not(.ancestor-out) { opacity: 0.68; }

  .pt-doc .lvtag { position: absolute; top: 3px; left: 4px; font-family: var(--mono); font-size: 8.5px; font-weight: 700; color: rgba(0,0,0,0.6); }

  /* timeline */
  .pt-doc .timeline {
    padding: 18px 20px 20px; border-top: 1px solid var(--line); background: rgba(255,255,255,0.012);
    display: grid; grid-template-columns: auto 1fr auto; gap: 14px 18px; align-items: center;
  }
  @media (max-width: 640px) { .pt-doc .timeline { grid-template-columns: 1fr; } }
  .pt-doc .play {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.04em; color: var(--ground);
    background: var(--amber); border: 0; padding: 9px 16px; border-radius: 8px; cursor: pointer;
    font-weight: 600; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
  }
  .pt-doc .play:hover { background: var(--amber-deep); }
  .pt-doc .play:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .pt-doc input[type=range] { width: 100%; accent-color: var(--amber-deep); cursor: pointer; height: 22px; }
  .pt-doc input[type=range]:focus-visible { outline: 2px solid var(--amber); outline-offset: 4px; border-radius: 4px; }
  .pt-doc .tl-state { font-family: var(--mono); font-size: 12px; color: var(--muted); text-align: right; min-width: 15ch; }
  .pt-doc .tl-state b { color: var(--ink); }
  .pt-doc .tl-legend { grid-column: 1 / -1; display: flex; justify-content: space-between; font-family: var(--mono); font-size: 10.5px; color: var(--faint); }

  /* trace readout */
  .pt-doc .trace {
    border-top: 1px solid var(--line); padding: 16px 20px 18px; background: #0f0b17;
    font-family: var(--mono); font-size: 13px; line-height: 1.7; min-height: 132px;
  }
  .pt-doc .trace .hint { color: var(--faint); }
  .pt-doc .trace-line { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: baseline; }
  .pt-doc .trace .arrow { color: var(--amber-deep); }
  .pt-doc .trace .lab { color: var(--faint); }
  .pt-doc .trace .val { color: var(--ink); }
  .pt-doc .trace .fallback { color: var(--l3); }
  .pt-doc .trace .exact { color: var(--l0); }
  .pt-doc .tk { padding: 1px 6px; border-radius: 4px; border: 1px solid var(--line-2); background: #1a1329; }
  .pt-doc .tk.lv0 { color: var(--l0); border-color: color-mix(in srgb, var(--l0) 40%, var(--line-2)); }
  .pt-doc .tk.lv1 { color: var(--l1); border-color: color-mix(in srgb, var(--l1) 40%, var(--line-2)); }
  .pt-doc .tk.lv2 { color: var(--l2); border-color: color-mix(in srgb, var(--l2) 40%, var(--line-2)); }
  .pt-doc .tk.lv3 { color: var(--l3); border-color: color-mix(in srgb, var(--l3) 40%, var(--line-2)); }

  /* encoding callout */
  .pt-doc .encode {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line);
    border: 1px solid var(--line-2); border-radius: 10px; overflow: hidden; margin: 18px 0 4px; max-width: 560px;
  }
  .pt-doc .encode .ch { background: #171120; padding: 12px 14px; }
  .pt-doc .encode .ch .cn { font-family: var(--mono); font-size: 20px; font-weight: 700; }
  .pt-doc .encode .ch .cd { font-family: var(--mono); font-size: 10.5px; color: var(--muted); margin-top: 4px; line-height: 1.4; }
  .pt-doc .encode .ch:nth-child(1) .cn { color: #ff6b6b; }
  .pt-doc .encode .ch:nth-child(2) .cn { color: #7dd87d; }
  .pt-doc .encode .ch:nth-child(3) .cn { color: #6ba6ff; }
  .pt-doc .encode .ch:nth-child(4) .cn { color: var(--amber); }

  /* code block */
  .pt-doc pre {
    font-family: var(--mono); font-size: 12.5px; line-height: 1.65; background: #0f0b17;
    border: 1px solid var(--line-2); border-radius: 12px; padding: 18px 20px; overflow-x: auto; color: #cfc8dc; margin: 18px 0;
  }
  .pt-doc pre .cm { color: var(--faint); }
  .pt-doc pre .fn { color: var(--amber); }
  .pt-doc pre .hl { color: var(--l0); }
  .pt-doc pre .kw { color: var(--l1); }

  .pt-doc ul.notes { max-width: 70ch; padding-left: 0; list-style: none; }
  .pt-doc ul.notes li { position: relative; padding-left: 26px; margin: 12px 0; color: #d0cadb; }
  .pt-doc ul.notes li::before {
    content: ""; position: absolute; left: 4px; top: 10px; width: 8px; height: 8px; border-radius: 2px;
    background: var(--amber-deep); box-shadow: 0 0 8px -1px var(--amber-deep);
  }
  .pt-doc ul.notes li b { color: var(--ink); }

  /* scaling walls */
  .pt-doc .walls { display: grid; gap: 12px; margin: 18px 0 6px; max-width: 74ch; }
  .pt-doc .wall { border: 1px solid var(--line-2); border-radius: 10px; background: #150f20; padding: 13px 16px 14px; }
  .pt-doc .wall-h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 10px; margin-bottom: 6px; }
  .pt-doc .wall-n { font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--ink); letter-spacing: 0.02em; }
  .pt-doc .wall-tag {
    font-family: var(--mono); font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--amber-deep); border: 1px solid var(--line-2); border-radius: 999px; padding: 2px 8px;
  }
  .pt-doc .wall p { max-width: none; margin: 4px 0; font-size: 14px; line-height: 1.55; color: #cbc4d8; }
  .pt-doc .wall .wall-now b { color: var(--l3); }   /* the ceiling */
  .pt-doc .wall .wall-plan b { color: var(--l0); }  /* the way forward */

  .pt-doc footer {
    margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--line);
    font-family: var(--mono); font-size: 12.5px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 8px 28px;
  }
  .pt-doc footer .lab { color: var(--faint); }

  /* Reduced motion: no fades, no movement — state shown as a faint tint + crisp level-coloured
     outline instead of a bright fill, so rapid streaming updates stay low-contrast. */
  @media (prefers-reduced-motion: reduce) {
    .pt-doc * { transition: none !important; }
    .pt-doc .cell.occ {
      background-color: color-mix(in srgb, var(--lv) 12%, #17121f);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--lv) 38%, transparent);
      color: color-mix(in srgb, var(--lv) 58%, #cfc8dc);
    }
    .pt-doc .cell.occ .lvtag { color: color-mix(in srgb, var(--lv) 58%, #cfc8dc); }
    .pt-doc .selblock.occ {
      background-color: color-mix(in srgb, var(--lv) 14%, #17121f);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--lv) 42%, transparent);
      color: color-mix(in srgb, var(--lv) 64%, #d6d0e0);
    }
    .pt-doc .selblock.occ .co { opacity: .78; }
    .pt-doc .dim-others .cell:not(.hot):not(.warm),
    .pt-doc .dim-others .selblock:not(.hot):not(.ancestor-out) { opacity: 0.82; }
  }
</style>

<script>
  (function () {
    "use strict";
    var root = document.querySelector(".pt-doc");
    if (!root) return;
    var cs = getComputedStyle(root);
    var PAGE = 8;    // finest grid edge (pageDims), 2D slice
    var LEVELS = 4;  // 0..3
    var FLOOR = 3;   // log2(PAGE) — coarsest full-chunk-grid level
    var ATLAS = 8;   // atlas slot grid edge (2D slice)
    var LVCOL = [
      cs.getPropertyValue("--l0").trim(),
      cs.getPropertyValue("--l1").trim(),
      cs.getPropertyValue("--l2").trim(),
      cs.getPropertyValue("--l3").trim(),
    ];
    function key(l, x, y) { return l + ":" + x + ":" + y; }
    function fp(l) { return 1 << l; }
    function byId(id) { return document.getElementById(id); }

    // ---- the mixed-LOD selection: a quadtree cut of the 8x8 finest grid ----
    var selection = [];
    for (var y = 0; y < 4; y++) for (var x = 0; x < 4; x++) selection.push({ l: 0, x: x, y: y }); // TL fine
    for (var y = 0; y < 2; y++) for (var x = 2; x < 4; x++) selection.push({ l: 1, x: x, y: y }); // TR
    for (var y = 2; y < 4; y++) for (var x = 0; x < 2; x++) selection.push({ l: 1, x: x, y: y }); // BL
    selection.push({ l: 2, x: 1, y: 1 }); // BR coarse
    var floorChunk = { l: FLOOR, x: 0, y: 0 };

    // cellDesired[y][x] = the selected chunk whose footprint contains finest cell (x,y)
    var cellDesired = [];
    for (var y = 0; y < PAGE; y++) cellDesired.push(new Array(PAGE));
    selection.forEach(function (c) {
      var s = fp(c.l);
      for (var dy = 0; dy < s; dy++) for (var dx = 0; dx < s; dx++) cellDesired[c.y * s + dy][c.x * s + dx] = c;
    });

    // ---- load order (streaming). floor first, then coarse→fine ----
    var loadOrder = [floorChunk];
    loadOrder.push({ l: 2, x: 1, y: 1 });
    for (var y = 0; y < 2; y++) for (var x = 2; x < 4; x++) loadOrder.push({ l: 1, x: x, y: y });
    for (var y = 2; y < 4; y++) for (var x = 0; x < 2; x++) loadOrder.push({ l: 1, x: x, y: y });
    for (var y = 0; y < 4; y++) for (var x = 0; x < 4; x++) loadOrder.push({ l: 0, x: x, y: y });
    var MAXSTEP = loadOrder.length; // 26

    var slotOfKey = {};
    loadOrder.forEach(function (c, i) { slotOfKey[key(c.l, c.x, c.y)] = i; });

    var step = MAXSTEP;
    var focus = null;
    var playing = false, timer = null;
    var REDUCE = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
    var PLAY_MS = REDUCE ? 720 : 380;

    function residentSet() {
      var s = {};
      for (var i = 0; i < step && i < loadOrder.length; i++) { var c = loadOrder[i]; s[key(c.l, c.x, c.y)] = c; }
      return s;
    }
    function residentOrAncestor(res, l, x, y) {
      while (l < LEVELS) {
        var k = key(l, x, y);
        if (res[k]) return { l: l, x: x, y: y, key: k };
        l++; x >>= 1; y >>= 1;
      }
      return null;
    }

    // ---------- build DOM ----------
    var legend = byId("pt-legend");
    ["L0 · finest", "L1", "L2", "L3 · floor"].forEach(function (t, i) {
      var el = document.createElement("span"); el.className = "lg";
      el.innerHTML = '<span class="swatch" style="background:' + LVCOL[i] + '"></span>' + t;
      legend.appendChild(el);
    });

    var selGrid = byId("pt-selGrid");
    var selBlocks = [];
    selection.forEach(function (c) {
      var b = document.createElement("div");
      b.className = "selblock";
      var s = fp(c.l);
      b.style.gridColumn = c.x * s + 1 + " / span " + s;
      b.style.gridRow = c.y * s + 1 + " / span " + s;
      b.innerHTML = '<span class="sl-lv">L' + c.l + '</span><span class="co">(' + c.x + "," + c.y + ")</span>";
      b.addEventListener("mouseenter", function () { setFocus({ x: c.x * s, y: c.y * s }); });
      b.addEventListener("mouseleave", clearFocus);
      b._chunk = c;
      selGrid.appendChild(b);
      selBlocks.push(b);
    });

    var ptGrid = byId("pt-ptGrid");
    var ptCells = [];
    for (var y = 0; y < PAGE; y++) {
      ptCells.push([]);
      for (var x = 0; x < PAGE; x++) {
        var cell = document.createElement("div");
        cell.className = "cell";
        (function (cx, cy) {
          cell.addEventListener("mouseenter", function () { setFocus({ x: cx, y: cy }); });
          cell.addEventListener("mouseleave", clearFocus);
        })(x, y);
        ptGrid.appendChild(cell);
        ptCells[y].push(cell);
      }
    }

    var atlasGrid = byId("pt-atlasGrid");
    var atlasCells = [];
    for (var i = 0; i < ATLAS * ATLAS; i++) {
      var acell = document.createElement("div");
      acell.className = "cell free";
      (function (idx) {
        acell.addEventListener("mouseenter", function () { focusSlot(idx); });
        acell.addEventListener("mouseleave", clearFocus);
      })(i);
      atlasGrid.appendChild(acell);
      atlasCells.push(acell);
    }

    function focusSlot(idx) {
      var res = residentSet();
      for (var y = 0; y < PAGE; y++) for (var x = 0; x < PAGE; x++) {
        var d = cellDesired[y][x]; if (!d) continue;
        var r = residentOrAncestor(res, d.l, d.x, d.y);
        if (r && slotOfKey[r.key] === idx) { setFocus({ x: x, y: y }); return; }
      }
    }

    // ---------- render ----------
    function render() {
      var res = residentSet();

      selBlocks.forEach(function (b) {
        var c = b._chunk;
        var resident = !!res[key(c.l, c.x, c.y)];
        b.classList.toggle("pending", !resident);
        b.classList.toggle("occ", resident);
        if (resident) b.style.setProperty("--lv", LVCOL[c.l]);
        else b.style.removeProperty("--lv");
      });

      for (var y = 0; y < PAGE; y++) for (var x = 0; x < PAGE; x++) {
        var cell = ptCells[y][x];
        var d = cellDesired[y][x];
        var r = d ? residentOrAncestor(res, d.l, d.x, d.y) : null;
        cell.className = "cell";
        if (!r) { cell.classList.add("empty"); cell.style.removeProperty("--lv"); cell.textContent = ""; }
        else { cell.classList.add("occ"); cell.style.setProperty("--lv", LVCOL[r.l]); cell.textContent = slotOfKey[r.key]; }
      }

      atlasCells.forEach(function (cell, i) {
        var c = i < step ? loadOrder[i] : null;
        cell.className = "cell";
        if (!c) { cell.classList.add("free"); cell.style.removeProperty("--lv"); cell.innerHTML = ""; }
        else { cell.classList.add("occ"); cell.style.setProperty("--lv", LVCOL[c.l]); cell.innerHTML = '<span class="lvtag">L' + c.l + "</span>"; }
      });

      byId("pt-scrub").value = step;
      byId("pt-tlState").innerHTML = stateLabel();
      renderFocus(res);
    }

    function stateLabel() {
      if (step === 0) return "<b>0 / " + MAXSTEP + "</b> · holes (pre-floor)";
      if (step === MAXSTEP) return "<b>" + MAXSTEP + " / " + MAXSTEP + "</b> · fully resident";
      if (step === 1) return "<b>1 / " + MAXSTEP + "</b> · floor only — coarse, no holes";
      return "<b>" + step + " / " + MAXSTEP + "</b> · streaming — sharpening";
    }

    function setFocus(f) { focus = f; byId("pt-console").classList.add("dim-others"); renderFocus(residentSet()); }
    function clearFocus() { focus = null; byId("pt-console").classList.remove("dim-others"); clearHot(); renderTrace(null); }

    function clearHot() {
      ptCells.forEach(function (rw) { rw.forEach(function (c) { c.classList.remove("hot", "warm"); }); });
      atlasCells.forEach(function (c) { c.classList.remove("hot"); });
      selBlocks.forEach(function (b) { b.classList.remove("hot", "ancestor-out"); });
    }

    function renderFocus(res) {
      clearHot();
      if (!focus) { renderTrace(null); return; }
      var d = cellDesired[focus.y][focus.x];
      if (!d) { renderTrace({ desired: null }); return; }
      var r = residentOrAncestor(res, d.l, d.x, d.y);

      selBlocks.forEach(function (b) {
        if (b._chunk === d) b.classList.add("hot");
        if (r && b._chunk.l === r.l && b._chunk.x === r.x && b._chunk.y === r.y && r.l !== d.l) b.classList.add("ancestor-out");
      });

      if (r) {
        var s = fp(r.l);
        var fx = r.x * s, fy = r.y * s;
        for (var dy = 0; dy < s; dy++) for (var dx = 0; dx < s; dx++) {
          var cy = fy + dy, cx = fx + dx;
          if (cy < PAGE && cx < PAGE) ptCells[cy][cx].classList.add(cx === focus.x && cy === focus.y ? "hot" : "warm");
        }
        var idx = slotOfKey[r.key];
        if (atlasCells[idx]) atlasCells[idx].classList.add("hot");
      }
      renderTrace({ desired: d, resolved: r });
    }

    function tokLv(l, text) { return '<span class="tk lv' + l + '">' + text + "</span>"; }

    function renderTrace(info) {
      var t = byId("pt-trace");
      if (!info) {
        t.innerHTML = '<span class="hint">Hover a cell to trace the lookup — the finest cell, the chunk it belongs to, the brick that actually serves it, and where that brick sits in the atlas.</span>';
        return;
      }
      if (!info.desired) { t.innerHTML = '<span class="hint">Outside the selection.</span>'; return; }
      var d = info.desired, r = info.resolved;
      var html = '<div class="trace-line"><span class="lab">finest cell</span> <span class="val">(' + focus.x + "," + focus.y + ")</span>"
        + ' <span class="arrow">∈</span> <span class="lab">selected chunk</span> ' + tokLv(d.l, "L" + d.l + " (" + d.x + "," + d.y + ")") + "</div>";
      if (!r) {
        html += '<div class="trace-line"><span class="fallback">✗ no resident ancestor yet — this is a hole. Load the floor (drag right) to guarantee a fallback.</span></div>';
        t.innerHTML = html; return;
      }
      var slotIdx = slotOfKey[r.key];
      var col = slotIdx % ATLAS, rowN = (slotIdx / ATLAS) | 0;
      if (r.l === d.l) {
        html += '<div class="trace-line"><span class="exact">✓ exact</span> <span class="lab">— chunk is resident.</span></div>';
      } else {
        var climbed = r.l - d.l;
        html += '<div class="trace-line"><span class="fallback">↑ fallback</span> <span class="lab">— walked up ' + climbed + " level" + (climbed > 1 ? "s" : "") + " to</span> " + tokLv(r.l, "L" + r.l + " (" + r.x + "," + r.y + ")") + ' <span class="lab">(finer not resident)</span></div>';
      }
      html += '<div class="trace-line"><span class="lab">page-table texel writes</span> <span class="tk">slot ' + slotIdx + " = (" + col + "," + rowN + ')</span> <span class="tk">A = level+1 = ' + (r.l + 1) + "</span></div>";
      var cells = fp(r.l);
      html += '<div class="trace-line"><span class="lab">shader:</span> <span class="val">cells = 2^' + r.l + " = " + cells + '</span> <span class="arrow">→</span> <span class="lab">this brick spans ' + cells + "×" + cells + " finest cells; sampled at " + (r.l === 0 ? "full" : "1/" + cells) + " resolution here.</span></div>";
      t.innerHTML = html;
    }

    // ---------- controls ----------
    byId("pt-scrub").addEventListener("input", function (e) { stopPlay(); step = parseInt(e.target.value, 10); render(); });

    var playBtn = byId("pt-playBtn");
    playBtn.addEventListener("click", function () {
      if (playing) { stopPlay(); return; }
      if (step >= MAXSTEP) step = 0;
      playing = true; playBtn.innerHTML = "❚❚&nbsp;&nbsp;Pause";
      timer = setInterval(function () {
        step++;
        if (step >= MAXSTEP) { step = MAXSTEP; render(); stopPlay(); return; }
        render();
      }, PLAY_MS);
      render();
    });
    function stopPlay() { playing = false; if (timer) clearInterval(timer); timer = null; playBtn.innerHTML = "▶&nbsp;&nbsp;Stream in"; }

    render();
  })();
</script>
