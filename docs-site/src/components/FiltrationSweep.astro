---
// Animated, rotatable 3D Vietoris-Rips filtration sweep with a synced persistence
// diagram. As the scale rises, balls grow around each point; touching balls form
// edges (components merge → H0); triangles fill enclosed regions (loops close → H1).
// The diagram's crosshair walks up the diagonal at the current scale and the alive
// features light up. Live Betti counts from a port of src/spatial/persistence.ts.
// No auto-rotation (drag to rotate).
---

<div class="fs-demo not-content">
  <div class="row">
    <label class="sel">shape
      <select id="fs-data">
        <option value="ring">ring (one loop)</option>
        <option value="eight">figure-eight (two loops)</option>
        <option value="clusters">two clusters (merging)</option>
      </select>
    </label>
    <span class="sel">view
      <span class="seg" id="fs-view" role="group" aria-label="view">
        <button class="segbtn on" data-view="flat" type="button">2D</button>
        <button class="segbtn" data-view="cones" type="button">cones</button>
        <button class="segbtn" data-view="both" type="button">both</button>
      </span>
    </span>
    <span class="betti"><b style="color:#3b82f6">H₀</b> <span id="fs-h0">–</span>&nbsp;&nbsp;<b style="color:#ef4444">H₁</b> <span id="fs-h1">–</span></span>
  </div>
  <div class="stagegrid">
    <div class="col">
      <div class="coltitle" id="fs-stagetitle">Vietoris–Rips complex</div>
      <div class="stageviews">
        <div id="fs-stage" class="view"></div>
        <div id="fs-cone" class="view"></div>
      </div>
      <div class="colcap" id="fs-stagecap"><span class="dot"></span>colour = connected component (H₀)</div>
    </div>
    <div class="col">
      <div class="coltitle">persistence diagram</div>
      <canvas id="fs-pd"></canvas>
      <div class="colcap">filled = alive at this scale · <span style="color:#3b82f6">H₀</span> / <span style="color:#ef4444">H₁</span></div>
    </div>
  </div>
  <div class="ctrl">
    <button id="fs-play" class="btn" aria-label="pause">⏸</button>
    <span class="lab">scale</span>
    <input type="range" id="fs-scale" min="0" max="1000" step="1" value="0" />
    <span id="fs-sval" class="val">0.0</span>
  </div>
</div>

<style>
  .fs-demo { margin: 1rem 0 1.5rem; }
  .fs-demo .row { display:flex; gap:14px; align-items:center; flex-wrap:wrap; margin-bottom:10px; }
  .fs-demo .sel { font-size:13px; color:var(--sl-color-gray-2); display:flex; gap:6px; align-items:center; }
  .fs-demo select { font-size:13px; padding:3px 6px; background:var(--sl-color-bg); color:var(--sl-color-text); border:1px solid var(--sl-color-gray-5); border-radius:6px; }
  .fs-demo .betti { margin-left:auto; font-size:14px; }
  .fs-demo .seg { display:inline-flex; border:1px solid var(--sl-color-gray-5); border-radius:6px; overflow:hidden; }
  .fs-demo .segbtn { font-size:12px; padding:3px 9px; background:transparent; color:var(--sl-color-gray-2); border:0; border-left:1px solid var(--sl-color-gray-5); cursor:pointer; }
  .fs-demo .segbtn:first-child { border-left:0; }
  .fs-demo .segbtn.on { background:var(--sl-color-gray-5); color:var(--sl-color-text); }
  .fs-demo .stagegrid { display:grid; grid-template-columns:1.4fr 1fr; gap:14px; align-items:start; }
  @media (max-width: 640px) { .fs-demo .stagegrid { grid-template-columns:1fr; } }
  .fs-demo .col { display:flex; flex-direction:column; }
  .fs-demo .coltitle { font-size:12px; font-weight:600; color:var(--sl-color-gray-2); margin-bottom:5px; height:16px; line-height:16px; }
  .fs-demo .stageviews { display:flex; gap:8px; }
  .fs-demo .stageviews .view { flex:1 1 0; min-width:0; height:320px; border-radius:8px; overflow:hidden; touch-action:none; background:var(--sl-color-gray-6); }
  .fs-demo[data-view="flat"] #fs-cone { display:none; }
  .fs-demo[data-view="cones"] #fs-stage { display:none; }
  .fs-demo #fs-pd { width:100%; height:320px; border-radius:8px; background:var(--sl-color-gray-6); }
  .fs-demo .colcap { font-size:11px; color:var(--sl-color-gray-3); margin-top:5px; height:15px; line-height:15px; display:flex; align-items:center; gap:5px; }
  .fs-demo .colcap .dot { width:8px; height:8px; border-radius:50%; flex:0 0 auto; background:linear-gradient(90deg,#3b82f6,#10b981,#f59e0b); }
  .fs-demo .ctrl { display:flex; gap:12px; align-items:center; margin-top:0.8rem; }
  .fs-demo .ctrl input { flex:1; }
  .fs-demo .btn { font-size:14px; width:32px; height:30px; display:flex; align-items:center; justify-content:center; border:1px solid var(--sl-color-gray-5); border-radius:6px; background:transparent; color:var(--sl-color-text); cursor:pointer; flex:0 0 auto; }
  .fs-demo .btn:hover { border-color:var(--sl-color-gray-4); }
  .fs-demo .lab { font-size:13px; color:var(--sl-color-gray-2); min-width:42px; }
  .fs-demo .val { font-size:14px; font-weight:600; min-width:42px; }
</style>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
  import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
  import { OutlinePass } from 'three/examples/jsm/postprocessing/OutlinePass.js';
  import { OutputPass } from 'three/examples/jsm/postprocessing/OutputPass.js';
  import { LineSegments2 } from 'three/examples/jsm/lines/LineSegments2.js';
  import { LineSegmentsGeometry } from 'three/examples/jsm/lines/LineSegmentsGeometry.js';
  import { LineMaterial } from 'three/examples/jsm/lines/LineMaterial.js';

  // ----------------------------------------------------------------------------
  // Types
  // ----------------------------------------------------------------------------

  /** A point cloud laid out on the y=0 plane (X horizontal, Z depth). */
  interface Dataset {
    X: number[];
    Z: number[];
    n: number;
  }

  /** Pairwise Euclidean distance matrix, D[i][j]. */
  type DistMatrix = number[][];

  /** A simplex in the Vietoris–Rips complex. */
  interface Simplex {
    /** Sorted vertex indices: [i] for a point, [i,j] for an edge, [i,j,k] for a triangle. */
    verts: number[];
    /** Filtration value at which it appears = max pairwise distance among its vertices. */
    birth: number;
    /** Topological dimension: 0 = point, 1 = edge, 2 = triangle. */
    dim: number;
  }

  /** A persistence bar: a feature of dimension `dim` alive over [birth, death). */
  interface Bar {
    dim: number;
    birth: number;
    death: number;
  }

  type Mode = 'ring' | 'eight' | 'clusters';
  // The 2-D view is locked top-down, so "influence balls" are flat disks (identical
  // from above). Keeping the whole complex coplanar means OutlinePass only finds true
  // silhouettes/holes — no false inner edges where flat triangles met tall spheres.
  type Ball = THREE.Mesh<THREE.CircleGeometry, THREE.MeshBasicMaterial>;

  // ----------------------------------------------------------------------------
  // Theme colours
  // ----------------------------------------------------------------------------

  /** Resolve a CSS custom property to a concrete colour string, with a fallback. */
  function probeColor(varName: string, fallback: string): string {
    const probe = document.createElement('span');
    probe.style.cssText = 'position:absolute;visibility:hidden;';
    probe.style.color = `var(${varName})`;
    document.body.appendChild(probe);
    const resolved = getComputedStyle(probe).color;
    probe.remove();
    return resolved || fallback;
  }

  /** Relative luminance (0–1) of an "rgb(...)" colour string. */
  function luminance(c: string): number {
    const m = c.match(/\d+(\.\d+)?/g);
    if (!m) return 0.5;
    const [r, g, b] = m.map(Number);
    return (0.299 * r + 0.587 * g + 0.114 * b) / 255;
  }

  // Theme-dependent inks. Mutable + re-probed on theme toggle (see applyTheme).
  let INK = probeColor('--sl-color-text', '#cbd5e1');
  let DIM = probeColor('--sl-color-gray-3', '#94a3b8');
  // Slice outline ink: near-black on light, near-white on dark (stronger contrast
  // than INK against the slice's own background). Recomputed in applyTheme.
  const sliceInk = () => (luminance(INK) > 0.5 ? '#e8edf6' : '#0a0d12');
  const sliceDim = () => (luminance(INK) > 0.5 ? '#3a4252' : '#5a6678');
  // Per-component colours for the 3D balls (indexed by component representative).
  const PALETTE = [
    0x3b82f6, 0xf59e0b, 0x10b981, 0xef4444, 0x8b5cf6,
    0xec4899, 0x14b8a6, 0xeab308, 0x06b6d4, 0xf43f5e,
  ];
  const H0_COLOR = '#3b82f6'; // components
  const H1_COLOR = '#ef4444'; // loops

  // ----------------------------------------------------------------------------
  // Persistent homology (a small port of src/spatial/persistence.ts)
  // ----------------------------------------------------------------------------

  /** Lexicographic comparison of two integer arrays. */
  function compareVerts(a: number[], b: number[]): number {
    const len = Math.min(a.length, b.length);
    for (let i = 0; i < len; i++) if (a[i] !== b[i]) return a[i] - b[i];
    return a.length - b.length;
  }

  /** Symmetric difference of two sorted arrays — i.e. column addition over Z/2. */
  function symmetricDiff(a: number[], b: number[]): number[] {
    const out: number[] = [];
    let i = 0, j = 0;
    while (i < a.length && j < b.length) {
      if (a[i] === b[j]) { i++; j++; }            // present in both → cancels
      else if (a[i] < b[j]) out.push(a[i++]);
      else out.push(b[j++]);
    }
    while (i < a.length) out.push(a[i++]);
    while (j < b.length) out.push(b[j++]);
    return out;
  }

  /**
   * Compute the persistence bars of the Vietoris–Rips complex on `D`, built up to
   * `maxScale`, via the standard boundary-matrix reduction over Z/2.
   */
  function persistence(D: DistMatrix, n: number, maxScale: number): Bar[] {
    const dist = (i: number, j: number) => D[i][j];

    // Build the complex: every point, plus edges and triangles within maxScale.
    const simplices: Simplex[] = [];
    for (let i = 0; i < n; i++) simplices.push({ verts: [i], birth: 0, dim: 0 });
    for (let i = 0; i < n; i++)
      for (let j = i + 1; j < n; j++)
        if (dist(i, j) <= maxScale)
          simplices.push({ verts: [i, j], birth: dist(i, j), dim: 1 });
    for (let i = 0; i < n; i++)
      for (let j = i + 1; j < n; j++) {
        if (dist(i, j) > maxScale) continue;
        for (let k = j + 1; k < n; k++) {
          const birth = Math.max(dist(i, j), dist(i, k), dist(j, k));
          if (birth <= maxScale) simplices.push({ verts: [i, j, k], birth, dim: 2 });
        }
      }

    // Filtration order: by birth, then dimension, then lexicographically.
    simplices.sort(
      (a, b) => a.birth - b.birth || a.dim - b.dim || compareVerts(a.verts, b.verts),
    );

    // Index every simplex so boundary columns can reference faces by position.
    const indexOf = new Map<string, number>();
    simplices.forEach((s, i) => indexOf.set(s.verts.join(','), i));

    // Boundary matrix: each column holds the (sorted) indices of a simplex's faces.
    const columns: number[][] = simplices.map((s) => {
      if (s.dim === 0) return [];
      const faces: number[] = [];
      for (let omit = 0; omit < s.verts.length; omit++) {
        const face = s.verts.filter((_, t) => t !== omit);
        faces.push(indexOf.get(face.join(','))!);
      }
      return faces.sort((a, b) => a - b);
    });

    // Reduce: clear each column's pivot against the column already owning that pivot.
    const lowestRow = (col: number[]) => (col.length ? col[col.length - 1] : -1);
    const colByPivot = new Map<number, number>(); // pivot row → reducing column
    const paired = new Set<number>();
    const bars: Bar[] = [];

    for (let j = 0; j < columns.length; j++) {
      let col = columns[j];
      let pivot = lowestRow(col);
      while (pivot !== -1 && colByPivot.has(pivot)) {
        col = symmetricDiff(col, columns[colByPivot.get(pivot)!]);
        pivot = lowestRow(col);
      }
      columns[j] = col;
      if (pivot !== -1) {
        colByPivot.set(pivot, j);
        const birthSimplex = simplices[pivot]; // the feature this column kills
        const death = simplices[j].birth;
        if (death > birthSimplex.birth)
          bars.push({ dim: birthSimplex.dim, birth: birthSimplex.birth, death });
        paired.add(pivot);
      }
    }

    // Simplices that create a feature but are never paired live forever (essential).
    for (let j = 0; j < columns.length; j++)
      if (columns[j].length === 0 && !paired.has(j))
        bars.push({ dim: simplices[j].dim, birth: simplices[j].birth, death: Infinity });

    return bars;
  }

  /** Betti numbers [b0, b1] = number of dim-0 / dim-1 bars alive at `scale`. */
  function betti(bars: Bar[], scale: number): [number, number] {
    let b0 = 0, b1 = 0;
    for (const bar of bars)
      if (bar.birth <= scale && scale < bar.death) {
        if (bar.dim === 0) b0++;
        else if (bar.dim === 1) b1++;
      }
    return [b0, b1];
  }

  // ----------------------------------------------------------------------------
  // Sample point clouds
  // ----------------------------------------------------------------------------

  function makeData(kind: Mode): Dataset {
    const X: number[] = [];
    const Z: number[] = [];
    if (kind === 'ring') {
      for (let i = 0; i < 22; i++) {
        const a = (2 * Math.PI * i) / 22;
        X.push(10 * Math.cos(a));
        Z.push(10 * Math.sin(a));
      }
    } else if (kind === 'eight') {
      for (const cx of [-6, 6])
        for (let t = 0; t < 14; t++) {
          const a = (2 * Math.PI * t) / 14;
          X.push(cx + 6 * Math.cos(a));
          Z.push(6 * Math.sin(a));
        }
    } else {
      // Two clusters with deterministic pseudo-random jitter (stable across reloads).
      const jitter = (q: number) => (Math.sin(q * 91.7) * 4137.1) % 1;
      for (let i = 0; i < 12; i++) {
        X.push(-7 + (jitter(i) - 0.5) * 5);
        Z.push((jitter(i + 50) - 0.5) * 8);
      }
      for (let i = 0; i < 12; i++) {
        X.push(7 + (jitter(i + 9) - 0.5) * 5);
        Z.push((jitter(i + 70) - 0.5) * 8);
      }
    }
    return { X, Z, n: X.length };
  }

  // ----------------------------------------------------------------------------
  // DOM + three.js setup
  // ----------------------------------------------------------------------------

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const root = document.querySelector('.fs-demo') as HTMLElement;
  const stage = byId<HTMLDivElement>('fs-stage');
  const coneStage = byId<HTMLDivElement>('fs-cone');
  const pd = byId<HTMLCanvasElement>('fs-pd');
  const h0Out = byId<HTMLSpanElement>('fs-h0');
  const h1Out = byId<HTMLSpanElement>('fs-h1');
  const scaleOut = byId<HTMLSpanElement>('fs-sval');
  const scaleInput = byId<HTMLInputElement>('fs-scale');
  const playBtn = byId<HTMLButtonElement>('fs-play');
  const dataSelect = byId<HTMLSelectElement>('fs-data');
  const stageTitle = byId<HTMLDivElement>('fs-stagetitle');
  const stageCap = byId<HTMLDivElement>('fs-stagecap');
  const segBtns = [...root.querySelectorAll<HTMLButtonElement>('.segbtn')];

  type ViewMode = 'flat' | 'cones' | 'both';
  let viewMode: ViewMode = 'flat';

  let stageW = stage.clientWidth || 520;
  const stageH = 320;

  const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  renderer.setSize(stageW, stageH);
  stage.appendChild(renderer.domElement);

  const scene = new THREE.Scene();
  // True 2-D: orthographic camera looking straight down −Y (no perspective, no
  // rotation). up=−Z so +X is screen-right and +Z is screen-down.
  let flatHalf = 17; // world half-height the frustum spans (reframed per shape)
  const camera = new THREE.OrthographicCamera(-flatHalf, flatHalf, flatHalf, -flatHalf, 0.1, 200);
  camera.position.set(0, 60, 0);
  camera.up.set(0, 0, -1);
  camera.lookAt(0, 0, 0);
  function setFlatFrustum(w: number, h: number): void {
    const a = w / h;
    camera.left = -flatHalf * a; camera.right = flatHalf * a;
    camera.top = flatHalf; camera.bottom = -flatHalf;
    camera.updateProjectionMatrix();
  }
  setFlatFrustum(stageW, stageH);
  scene.add(new THREE.AmbientLight(0xffffff, 0.8));
  const keyLight = new THREE.DirectionalLight(0xffffff, 0.65);
  keyLight.position.set(8, 30, 18);
  scene.add(keyLight);

  // Everything rotatable lives in `group`; the camera/lights stay put.
  const group = new THREE.Group();
  scene.add(group);
  const diskGeo = new THREE.CircleGeometry(1, 44);
  diskGeo.rotateX(-Math.PI / 2); // lie flat in the XZ plane, facing +Y (the camera)

  // ----------------------------------------------------------------------------
  // Post-processing: a glowing outline around each connected region (and its
  // holes, i.e. loops), so connectivity reads at a glance. OutlinePass traces the
  // silhouette of the ball union — the outer boundary of a component plus the
  // inner boundary of any enclosed loop. selectedObjects is refreshed per build.
  // ----------------------------------------------------------------------------

  const composer = new EffectComposer(renderer);
  composer.setPixelRatio(renderer.getPixelRatio());
  composer.setSize(stageW, stageH);
  composer.addPass(new RenderPass(scene, camera));
  const outlinePass = new OutlinePass(new THREE.Vector2(stageW, stageH), scene, camera);
  outlinePass.edgeStrength = 3.0;
  outlinePass.edgeGlow = 0.4;
  outlinePass.edgeThickness = 1.0;
  outlinePass.visibleEdgeColor.set(INK); // theme ink: bright on dark, dark on light
  outlinePass.hiddenEdgeColor.set(DIM);
  composer.addPass(outlinePass);
  composer.addPass(new OutputPass());

  // ----------------------------------------------------------------------------
  // Cone (scale-space) view — a second canvas. Each point becomes a cone of the
  // distance-to-that-point function: apex at the point, widening with height, where
  // height = scale. A horizontal slice plane at y = scale cuts each cone in a circle
  // of radius scale/2 — exactly the 2-D disk at that scale. So sweeping the plane up
  // the cones *is* the filtration, and the 2-D view is one slice of this object.
  // ----------------------------------------------------------------------------

  const coneRenderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
  coneRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  coneRenderer.setSize(stageW, stageH);
  coneStage.appendChild(coneRenderer.domElement);
  const coneScene = new THREE.Scene();
  const coneCam = new THREE.PerspectiveCamera(45, stageW / stageH, 0.1, 800);
  coneScene.add(new THREE.AmbientLight(0xffffff, 0.85));
  const coneKey = new THREE.DirectionalLight(0xffffff, 0.5);
  coneKey.position.set(10, 30, 20);
  coneScene.add(coneKey);
  const coneGroup = new THREE.Group();
  coneScene.add(coneGroup);
  // Unit cone, apex at the origin opening +Y, radius = y/2 (so at y=1, r=0.5).
  const coneUnit = new THREE.ConeGeometry(0.5, 1, 48, 1, true);
  coneUnit.rotateX(Math.PI);       // flip apex downward
  coneUnit.translate(0, 0.5, 0);   // apex at y=0, base (r=0.5) at y=1
  const apexGeo = new THREE.SphereGeometry(0.4, 14, 10); // point dot at each cone apex

  // The slice plane shows the actual 2-D complex (component-coloured balls, edges,
  // filled triangles). The flat and cone views are separate WebGL contexts, so rather
  // than share the flat canvas (cross-context + variable aspect), we re-render the
  // same `scene` here in the cone context through a *square* ortho camera into a
  // render target, and texture the slice with it — square in, square out, no aspect
  // mismatch, and each disk lands exactly over its cone.
  const sliceCam = new THREE.OrthographicCamera(-12, 12, 12, -12, 0.1, 200);
  sliceCam.position.set(0, 60, 0);
  sliceCam.up.set(0, 0, -1);
  sliceCam.lookAt(0, 0, 0);
  // Full 2-D pipeline (RenderPass → OutlinePass → OutputPass) over the flat scene,
  // rendered off-screen here so the slice carries the same glow + colour as the 2-D
  // view. renderToScreen=false → result lands in the composer's read buffer.
  const sliceComposer = new EffectComposer(coneRenderer);
  sliceComposer.renderToScreen = false;
  sliceComposer.setSize(1024, 1024);
  sliceComposer.setPixelRatio(1);
  sliceComposer.addPass(new RenderPass(scene, sliceCam));
  const sliceOutline = new OutlinePass(new THREE.Vector2(124, 1024), scene, sliceCam);
  sliceOutline.edgeStrength = 3.0;
  sliceOutline.edgeGlow = 0.4;
  sliceOutline.edgeThickness = 1.0;
  sliceOutline.visibleEdgeColor.set(sliceInk()); // near-black on light / near-white on dark
  sliceOutline.hiddenEdgeColor.set(sliceDim());
  sliceComposer.addPass(sliceOutline);
  // No OutputPass: keep the slice texture linear and let the cone renderer's own
  // output apply sRGB when the slice plane is drawn — one encode, matching the 2-D
  // view. (Previously OutputPass encoded sRGB into the RT and the renderer encoded
  // again → a washed-out tone/colour-space mismatch between the two views.)
  sliceComposer.renderTarget1.texture.colorSpace = THREE.LinearSRGBColorSpace;
  sliceComposer.renderTarget2.texture.colorSpace = THREE.LinearSRGBColorSpace;

  // Orbit state for the cone camera (azimuth/elevation around a target on the Y axis).
  let coneAz = -0.6, coneEl = 0.42, coneDist = 40, coneTargetY = 6;
  function updateConeCam(): void {
    const ce = Math.cos(coneEl);
    coneCam.position.set(
      ce * Math.sin(coneAz) * coneDist,
      coneTargetY + Math.sin(coneEl) * coneDist,
      ce * Math.cos(coneAz) * coneDist,
    );
    coneCam.lookAt(0, coneTargetY, 0);
  }

  // ----------------------------------------------------------------------------
  // Scene state (rebuilt whenever the shape changes)
  // ----------------------------------------------------------------------------

  let data: Dataset;
  let D: DistMatrix;
  let bars: Bar[];
  let maxScale: number;
  let balls: Ball[] = [];
  let verts: Ball[] = []; // small solid dots marking the actual points (the 0-simplices)
  let edges: LineSegments2; // fat (world-unit) lines, so they survive the slice minification
  let edgePos: Float32Array; // flat [x,y,z, x,y,z, ...] for every potential edge
  let tris: THREE.Mesh;
  let triPos: Float32Array; // flat triangle vertices for every potential triangle
  // Cone-view scene state.
  let coneMeshes: THREE.Mesh<THREE.ConeGeometry, THREE.MeshStandardMaterial>[] = [];
  let apexMeshes: THREE.Mesh<THREE.SphereGeometry, THREE.MeshBasicMaterial>[] = []; // point dots at cone apexes
  let slicePlane: THREE.Mesh;
  let planeHalf = 12; // world half-width the slice plane / canvas spans

  function buildScene(kind: Mode): void {
    while (group.children.length) group.remove(group.children[0]);
    balls = [];

    data = makeData(kind);
    const n = data.n;

    // Pairwise distances.
    D = [];
    for (let i = 0; i < n; i++) {
      D[i] = [];
      for (let j = 0; j < n; j++)
        D[i][j] = Math.hypot(data.X[i] - data.X[j], data.Z[i] - data.Z[j]);
    }

    // Largest pairwise distance sets a hard upper bound on the sweep.
    let maxDist = 0;
    for (let i = 0; i < n; i++)
      for (let j = i + 1; j < n; j++) maxDist = Math.max(maxDist, D[i][j]);
    const fullScale = maxDist * 1.02;

    // Bound the sweep to just past the largest genuine feature death — going further
    // pushes the triangles-only complex into the dense regime, where it sprouts
    // spurious essential H1 (you'd need tetrahedra to kill them).
    const fullBars = persistence(D, n, fullScale);
    let lastRealDeath = 0;
    for (const bar of fullBars)
      if (isFinite(bar.death) && bar.death - bar.birth > fullScale * 0.03)
        lastRealDeath = Math.max(lastRealDeath, bar.death);
    maxScale = Math.min(fullScale, lastRealDeath > 0 ? lastRealDeath * 1.2 : fullScale);

    // Frame the 2-D view to fit the points plus their largest disks (radius maxScale/2).
    let extent = 0;
    for (let i = 0; i < n; i++) extent = Math.max(extent, Math.abs(data.X[i]), Math.abs(data.Z[i]));
    flatHalf = extent + maxScale / 2 + 2;
    setFlatFrustum(stage.clientWidth || stageW, stageH);

    bars = persistence(D, n, maxScale);

    // Keep only the H0/H1 story this 2-D demo is about, and drop its noise:
    //  • dim ≥ 2 (H2): the reduction emits a never-dying 2-cycle for every unpaired
    //    triangle — no tetrahedra exist to kill them. They're meaningless here, yet
    //    the diagram drew each as a red tick along the top edge (the noise band).
    //  • essential H1: a cycle-creating edge between already-connected points opens a
    //    loop nothing can close, so it never dies. A *genuine* loop always fills with
    //    triangles before maxScale, so it's finite — only the spurious ones are essential.
    //  • tiny finite H1: short-lived loops from point jitter.
    const minLoopPersistence = maxScale * 0.04;
    bars = bars.filter((bar) => {
      if (bar.dim >= 2) return false;                     // no H2 story in 2-D
      if (bar.dim === 0) return true;                     // keep all components
      if (!isFinite(bar.death)) return false;             // drop never-dying loops
      return bar.death - bar.birth >= minLoopPersistence; // drop tiny transient loops
    });

    // Balls — translucent influence spheres. depthWrite:false so they blend cleanly
    // instead of fighting the depth buffer; renderOrder pushes them after the edges.
    for (let i = 0; i < n; i++) {
      const ball: Ball = new THREE.Mesh(
        diskGeo,
        new THREE.MeshBasicMaterial({
          transparent: true,
          blending: THREE.AdditiveBlending,
          opacity: 0.2,
          depthWrite: false,
          depthTest: false,
        }),
      );
      ball.renderOrder = 2;
      ball.position.set(data.X[i], 0, data.Z[i]);
      group.add(ball);
      balls.push(ball);
    }

    // Vertices — small solid dots at each point (the 0-simplices), fixed size, on top.
    verts = [];
    for (let i = 0; i < n; i++) {
      const v: Ball = new THREE.Mesh(
        diskGeo,
        new THREE.MeshBasicMaterial({ depthWrite: false, depthTest: false }),
      );
      v.scale.setScalar(0.42);
      v.position.set(data.X[i], 0, data.Z[i]);
      v.renderOrder = 4; // above disks, edges, triangles
      group.add(v);
      verts.push(v);
    }

    // Edges — fat world-unit lines (LineSegments2), rebuilt each frame from the
    // active pairs. World-unit width means real geometric thickness, so they read
    // both in the 2-D view and after the slice's render-target minification.
    const maxEdges = (n * (n - 1)) / 2;
    edgePos = new Float32Array(maxEdges * 6);
    const edgeMat = new LineMaterial({
      color: new THREE.Color(INK).getHex(), worldUnits: true, linewidth: 0.1,
      transparent: true, opacity: 0.6, depthTest: false,
    });
    edgeMat.resolution.set(stageW, stageH);
    edges = new LineSegments2(new LineSegmentsGeometry(), edgeMat);
    edges.geometry.setPositions(edgePos); // wrap the preallocated buffer ONCE; we then
    edges.frustumCulled = false;          // update it in place + gate with instanceCount
    edges.renderOrder = 3; // on top of the additive disks, so they aren't washed pale
    group.add(edges);

    // Triangles — likewise preallocated, gated by drawRange.
    const maxTris = (n * (n - 1) * (n - 2)) / 6;
    triPos = new Float32Array(maxTris * 9);
    const triGeo = new THREE.BufferGeometry();
    triGeo.setAttribute('position', new THREE.BufferAttribute(triPos, 3));
    // Filled, calm translucent triangles. These are the 2-simplices that *fill* a
    // loop — when they cover its interior the loop is no longer a hole and H₁ dies,
    // so showing them makes the outline closing legible. depthTest:false + a low
    // renderOrder avoids the z-fighting/dominance the additive wireframe had: they
    // sit as a flat wash beneath the edges and balls.
    tris = new THREE.Mesh(
      triGeo,
      new THREE.MeshBasicMaterial({
        color: 0x8b5cf6,
        transparent: true,
        opacity: 0.16,
        side: THREE.DoubleSide,
        depthWrite: false,
        depthTest: false,
      }),
    );
    tris.renderOrder = 0;
    group.add(tris);

    // Outline balls + filled triangles together. Including the triangles is what
    // keeps the visual in step with the homology: a loop's hole closes exactly when
    // triangles fill it (= when H₁ dies), not later when the fat balls finally meet.
    // (OutlinePass renders selected objects solid for its mask, ignoring the tris'
    // wireframe display material, so the filling is real even though we draw it wire.)
    outlinePass.selectedObjects = [...balls, tris];
    sliceOutline.selectedObjects = [...balls, tris];

    buildCone();
  }

  /** (Re)build the cone-view scene for the current data + maxScale. */
  function buildCone(): void {
    while (coneGroup.children.length) coneGroup.remove(coneGroup.children[0]);
    const n = data.n;

    // One filled, translucent cone per point: apex at the point, base radius
    // maxScale/2 at y = maxScale. Each gets its own material so it can be tinted by
    // connected component every frame, exactly like its disk in the 2-D view.
    coneMeshes = [];
    for (let i = 0; i < n; i++) {
      const cone = new THREE.Mesh(coneUnit, new THREE.MeshStandardMaterial({
        transparent: true, opacity: 0.09, roughness: 0.75,
        side: THREE.DoubleSide, depthWrite: false,
      }));
      cone.scale.setScalar(maxScale);
      cone.position.set(data.X[i], 0, data.Z[i]);
      coneGroup.add(cone);
      coneMeshes.push(cone);
    }

    // Point dots at the cone apexes (the 0-simplices, in 3-D).
    apexMeshes = [];
    for (let i = 0; i < n; i++) {
      const dot = new THREE.Mesh(apexGeo, new THREE.MeshBasicMaterial());
      dot.position.set(data.X[i], 0, data.Z[i]);
      coneGroup.add(dot);
      apexMeshes.push(dot);
    }

    // Horizontal slice plane, its face textured with the re-rendered 2-D complex.
    // Sized + the square slice camera framed to the points + their largest disks.
    let ext = 0;
    for (let i = 0; i < n; i++) ext = Math.max(ext, Math.abs(data.X[i]), Math.abs(data.Z[i]));
    planeHalf = ext + maxScale / 2 + 2;
    sliceCam.left = -planeHalf; sliceCam.right = planeHalf;
    sliceCam.top = planeHalf; sliceCam.bottom = -planeHalf;
    sliceCam.updateProjectionMatrix();
    slicePlane = new THREE.Mesh(
      new THREE.PlaneGeometry(2 * planeHalf, 2 * planeHalf),
      new THREE.MeshBasicMaterial({
        transparent: true, side: THREE.DoubleSide,
        depthWrite: false, depthTest: false, // sit on top of the cones so it reads
      }),
    );
    slicePlane.rotation.x = -Math.PI / 2; // lie flat in the XZ plane
    slicePlane.renderOrder = 10;
    coneGroup.add(slicePlane);

    // Frame the camera to the cone stack's height.
    coneTargetY = maxScale * 0.42;
    coneDist = maxScale * 2.4;
    updateConeCam();
  }

  /** Lift the slice plane to y = scale (its texture is refreshed in the frame loop). */
  function updateCone(scale: number): void {
    slicePlane.position.y = scale;
  }

  /**
   * Connected-component representative for each point at `scale`, via union-find.
   * The root is always the lowest index in the component, so each component's
   * colour stays fixed across the sweep: it only changes on a genuine merge, where
   * the survivor keeps the lower index's colour — no per-frame relabelling flicker.
   */
  function componentReps(n: number, scale: number): number[] {
    const parent: number[] = [];
    for (let i = 0; i < n; i++) parent[i] = i;
    const find = (a: number): number => {
      while (parent[a] !== a) {
        parent[a] = parent[parent[a]]; // path-halving
        a = parent[a];
      }
      return a;
    };
    for (let i = 0; i < n; i++)
      for (let j = i + 1; j < n; j++)
        if (D[i][j] <= scale) {
          const ra = find(i), rb = find(j);
          if (ra !== rb) parent[Math.max(ra, rb)] = Math.min(ra, rb); // root = min index
        }
    const reps: number[] = [];
    for (let i = 0; i < n; i++) reps[i] = find(i);
    return reps;
  }

  // ----------------------------------------------------------------------------
  // Persistence diagram (2D canvas)
  // ----------------------------------------------------------------------------

  function drawPD(scale: number): void {
    const rect = pd.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    pd.width = rect.width * dpr;
    pd.height = rect.height * dpr;
    const ctx = pd.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const w = rect.width, h = rect.height, pad = 28;
    const side = Math.min(w, h) - 2 * pad;
    const ox = (w - side) / 2, oy = (h - side) / 2;
    // Map a birth/death value to a pixel coordinate (death axis points up).
    const toX = (v: number) => ox + (v / maxScale) * side;
    const toY = (v: number) => oy + side - (Math.min(v, maxScale) / maxScale) * side;

    ctx.clearRect(0, 0, w, h);

    // Alive region (birth ≤ scale < death) = upper-left of (scale, scale).
    ctx.fillStyle = 'rgba(99,102,241,0.10)';
    ctx.fillRect(toX(0), toY(maxScale), toX(scale) - toX(0), toY(scale) - toY(maxScale));

    // Axes.
    ctx.strokeStyle = 'rgba(128,128,128,0.4)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(toX(0), toY(0)); ctx.lineTo(toX(maxScale), toY(0));
    ctx.moveTo(toX(0), toY(0)); ctx.lineTo(toX(0), toY(maxScale));
    ctx.stroke();

    // Diagonal (birth = death).
    ctx.strokeStyle = 'rgba(128,128,128,0.5)';
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    ctx.moveTo(toX(0), toY(0)); ctx.lineTo(toX(maxScale), toY(maxScale));
    ctx.stroke();
    ctx.setLineDash([]);

    // Axis labels.
    ctx.fillStyle = DIM;
    ctx.font = '10px sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('birth →', ox + side / 2, oy + side + 16);
    ctx.save();
    ctx.translate(ox - 15, oy + side / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('death →', 0, 0);
    ctx.restore();

    // Bars as points; alive ones brighten and grow.
    for (const bar of bars) {
      const deathY = isFinite(bar.death) ? bar.death : maxScale;
      // Skip negligible bars (numerical near-diagonal noise).
      if (isFinite(bar.death) && bar.death - bar.birth < maxScale * 0.02) continue;
      const alive = bar.birth <= scale && scale < bar.death;
      ctx.globalAlpha = alive ? 1 : 0.22;
      ctx.fillStyle = bar.dim === 0 ? H0_COLOR : H1_COLOR;
      const radius = bar.dim === 1 ? (alive ? 5.5 : 3.5) : (alive ? 3.4 : 2.2);
      ctx.beginPath();
      ctx.arc(toX(bar.birth), toY(deathY), radius, 0, 6.2832);
      ctx.fill();
      // Essential (never-dying) bars get an upward tick at the top edge.
      if (!isFinite(bar.death)) {
        ctx.globalAlpha = alive ? 1 : 0.3;
        ctx.strokeStyle = bar.dim === 0 ? H0_COLOR : H1_COLOR;
        ctx.beginPath();
        ctx.moveTo(toX(bar.birth), toY(deathY) - 8);
        ctx.lineTo(toX(bar.birth), toY(deathY) - 1);
        ctx.stroke();
      }
    }
    ctx.globalAlpha = 1;

    // Sweep crosshair at (scale, scale).
    ctx.strokeStyle = 'rgba(128,128,128,0.55)';
    ctx.setLineDash([2, 3]);
    ctx.beginPath();
    ctx.moveTo(toX(scale), toY(scale)); ctx.lineTo(toX(scale), toY(maxScale));
    ctx.moveTo(toX(0), toY(scale)); ctx.lineTo(toX(scale), toY(scale));
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = INK;
    ctx.beginPath();
    ctx.arc(toX(scale), toY(scale), 3.2, 0, 6.2832);
    ctx.fill();
  }

  // ----------------------------------------------------------------------------
  // Per-frame update: grow balls, draw edges/triangles, refresh diagram + counts
  // ----------------------------------------------------------------------------

  function update(scale: number): void {
    const n = data.n;
    const reps = componentReps(n, scale);

    // Ball radius = scale/2 (the Vietoris–Rips convention). ×7 (coprime to the
    // palette length) spreads adjacent component reps to distinct hues; merged
    // components collapse toward a single hue.
    for (let i = 0; i < n; i++) {
      const col = PALETTE[(reps[i] * 7) % PALETTE.length];
      balls[i].scale.setScalar(Math.max(0.18, scale / 2));
      balls[i].material.color.setHex(col);
      verts[i].material.color.setHex(col);       // point dot, 2-D + slice
      coneMeshes[i].material.color.setHex(col);   // cone tint
      apexMeshes[i].material.color.setHex(col);   // point dot, cone view
    }

    // Edges: one segment per pair within `scale`.
    let edgeCount = 0;
    for (let i = 0; i < n; i++)
      for (let j = i + 1; j < n; j++)
        if (D[i][j] <= scale) {
          const o = edgeCount * 6;
          edgePos[o] = data.X[i];     edgePos[o + 1] = 0; edgePos[o + 2] = data.Z[i];
          edgePos[o + 3] = data.X[j]; edgePos[o + 4] = 0; edgePos[o + 5] = data.Z[j];
          edgeCount++;
        }
    // Update the (preallocated) line buffer in place and gate how many segments draw —
    // no per-frame buffer recreation, so a render can't catch a half-uploaded buffer.
    edges.visible = edgeCount > 0;
    edges.geometry.instanceCount = edgeCount;
    (edges.geometry.getAttribute('instanceStart') as THREE.InterleavedBufferAttribute).data.needsUpdate = true;

    // Triangles: every triple whose three edges are all within `scale`.
    let triCount = 0;
    for (let i = 0; i < n; i++)
      for (let j = i + 1; j < n; j++) {
        if (D[i][j] > scale) continue;
        for (let k = j + 1; k < n; k++)
          if (D[i][k] <= scale && D[j][k] <= scale) {
            const o = triCount * 9;
            triPos[o] = data.X[i];     triPos[o + 1] = 0; triPos[o + 2] = data.Z[i];
            triPos[o + 3] = data.X[j]; triPos[o + 4] = 0; triPos[o + 5] = data.Z[j];
            triPos[o + 6] = data.X[k]; triPos[o + 7] = 0; triPos[o + 8] = data.Z[k];
            triCount++;
          }
      }
    tris.geometry.setDrawRange(0, triCount * 3);
    tris.geometry.attributes.position.needsUpdate = true;

    // Readouts.
    const [b0, b1] = betti(bars, scale);
    h0Out.textContent = String(b0);
    h1Out.textContent = String(b1);
    scaleOut.textContent = scale.toFixed(1);
    if (document.activeElement !== scaleInput)
      scaleInput.value = String(Math.round((scale / maxScale) * 1000));

    drawPD(scale);
    updateCone(scale);
  }

  // ----------------------------------------------------------------------------
  // View mode + layout: the 2-D and cone views are separate canvases, shown alone
  // or side by side. Switching re-sizes the visible renderer(s) and reframes.
  // ----------------------------------------------------------------------------

  function layout(): void {
    root.dataset.view = viewMode;
    for (const b of segBtns) b.classList.toggle('on', b.dataset.view === viewMode);
    if (viewMode !== 'cones') {
      const w = stage.clientWidth || 300;
      renderer.setSize(w, stageH);
      composer.setSize(w, stageH);
      setFlatFrustum(w, stageH);
    }
    if (viewMode !== 'flat') {
      const w = coneStage.clientWidth || 300;
      coneRenderer.setSize(w, stageH);
      coneCam.aspect = w / stageH;
      coneCam.updateProjectionMatrix();
    }
    stageTitle.textContent =
      viewMode === 'cones' ? 'scale-space (cones)'
        : viewMode === 'both' ? 'complex · scale-space'
          : 'Vietoris–Rips complex';
    stageCap.innerHTML =
      viewMode === 'flat'
        ? '<span class="dot"></span>colour = connected component (H₀)'
        : 'height = scale · slice = current complex · drag to rotate';
  }

  for (const b of segBtns)
    b.addEventListener('click', () => {
      viewMode = (b.dataset.view as ViewMode) ?? 'flat';
      layout();
      update(scale);
    });

  // ----------------------------------------------------------------------------
  // Interaction: drag to orbit the cone view, play/pause, scrub, change shape
  // ----------------------------------------------------------------------------

  let dragging = false, lastX = 0, lastY = 0;
  coneRenderer.domElement.addEventListener('pointerdown', (e: PointerEvent) => {
    dragging = true;
    lastX = e.clientX;
    lastY = e.clientY;
  });
  window.addEventListener('pointerup', () => { dragging = false; });
  window.addEventListener('pointermove', (e: PointerEvent) => {
    if (!dragging) return;
    coneAz -= (e.clientX - lastX) * 0.01;
    coneEl = Math.max(0.06, Math.min(1.45, coneEl + (e.clientY - lastY) * 0.01));
    updateConeCam();
    lastX = e.clientX;
    lastY = e.clientY;
  });

  let playing = true;
  let scale = 0;
  let startTime: number | null = null;
  const SWEEP_MS = 9000; // time to sweep 0 → maxScale
  const HOLD_MS = 1400;  // pause at the top before looping

  function setPlaying(on: boolean): void {
    playing = on;
    playBtn.textContent = on ? '⏸' : '▶';
    playBtn.setAttribute('aria-label', on ? 'pause' : 'play');
  }

  playBtn.addEventListener('click', () => {
    setPlaying(!playing);
    startTime = null; // resync the sweep clock on resume
  });
  scaleInput.addEventListener('input', function () {
    setPlaying(false);
    scale = (Number(this.value) / 1000) * maxScale;
    update(scale);
  });
  dataSelect.addEventListener('change', function () {
    buildScene(this.value as Mode);
    scale = 0;
    startTime = null;
    setPlaying(true);
  });
  window.addEventListener('resize', () => {
    layout();
    update(scale);
  });

  // Re-ink theme-dependent colours when the user toggles light/dark at runtime.
  // (CSS vars update live; we just re-probe and push the new inks into three.js.)
  function applyTheme(): void {
    INK = probeColor('--sl-color-text', '#cbd5e1');
    DIM = probeColor('--sl-color-gray-3', '#94a3b8');
    if (edges) (edges.material as LineMaterial).color.set(INK);
    outlinePass.visibleEdgeColor.set(INK);
    outlinePass.hiddenEdgeColor.set(DIM);
    sliceOutline.visibleEdgeColor.set(sliceInk());
    sliceOutline.hiddenEdgeColor.set(sliceDim());
    drawPD(scale);
  }
  new MutationObserver(applyTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class', 'data-theme'],
  });

  // ----------------------------------------------------------------------------
  // Animation loop
  // ----------------------------------------------------------------------------

  function frame(ts: number): void {
    requestAnimationFrame(frame);
    if (playing) {
      if (startTime === null) startTime = ts;
      const elapsed = (ts - startTime) % (SWEEP_MS + HOLD_MS);
      scale = Math.min(1, elapsed / SWEEP_MS) * maxScale;
      update(scale);
    }
    if (viewMode !== 'cones') composer.render();
    if (viewMode !== 'flat') {
      // Re-render the 2-D complex (square, full pipeline) into the slice texture,
      // bind it to the slice face, then draw the cones.
      sliceComposer.render();
      (slicePlane.material as THREE.MeshBasicMaterial).map = sliceComposer.readBuffer.texture;
      coneRenderer.setRenderTarget(null);
      coneRenderer.render(coneScene, coneCam);
    }
  }

  buildScene('ring');
  update(0);
  layout();
  requestAnimationFrame(frame);
</script>
