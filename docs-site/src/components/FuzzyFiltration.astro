---
// Hard vs fuzzy filtrations, side by side, driven by the toolbox's OWN library
// code (no re-ported reducer): `src/spatial/scalarField.ts` builds the fields and
// `src/spatial/sublevelsetPersistence.ts` reduces them.
//
//   • HARD  — sublevel sets of the distance-to-nearest-point field = the union of
//     growing balls (Cech-style). Boundaries have corners where balls meet, and a
//     lone outlier spawns a full-strength ball at r=0 → a long, important-looking
//     bar.
//   • FUZZY — superlevel sets of a Gaussian KDE (smooth, C-infinity boundaries),
//     or sublevel sets of the distance-to-measure (DTM) field (robust to outliers).
//
// Sweep one parameter u: 0→1; both sets grow from nothing to everything. The
// persistence diagrams below show the payoff: with outliers on, the hard diagram
// fills with features far from the diagonal, while the fuzzy ones keep noise near
// the diagonal and the true feature prominent.
---

<div class="ff-demo">
  <div class="row">
    <label class="sel">shape
      <select id="ff-data">
        <option value="ring">ring (one loop)</option>
        <option value="clusters">three blobs</option>
        <option value="eight">figure-eight (two loops)</option>
      </select>
    </label>
    <label class="sel chk"><input type="checkbox" id="ff-noise" checked /> add outliers</label>
    <span class="sel">fuzzy field
      <span class="seg" id="ff-method" role="group" aria-label="fuzzy field">
        <button class="segbtn on" data-method="kde" type="button">KDE</button>
        <button class="segbtn" data-method="dtm" type="button">DTM</button>
      </span>
    </span>
    <span class="backend" id="ff-backend" title="field-generation backend">CPU</span>
  </div>

  <div class="row params">
    <label class="sel">resolution
      <select id="ff-res">
        <option value="48">48²</option>
        <option value="64" selected>64²</option>
        <option value="80">80²</option>
        <option value="96">96²</option>
      </select>
    </label>
    <label class="sel rng">
      <span id="ff-falloff-label">bandwidth&nbsp;σ</span>
      <input type="range" id="ff-falloff" min="8" max="40" step="1" value="19" />
      <span class="val sm" id="ff-falloff-val">1.9</span>
    </label>
    <label class="sel rng">
      <span>noise&nbsp;band</span>
      <input type="range" id="ff-band" min="0" max="200" step="5" value="80" />
      <span class="val sm" id="ff-band-val">0.08</span>
    </label>
    <label class="sel chk" id="ff-gpu-wrap" hidden><input type="checkbox" id="ff-gpu" /> WebGPU</label>
  </div>

  <div class="grid2">
    <div class="cell">
      <div class="celltitle">hard — union of balls <span class="tag">distance, sublevel</span></div>
      <canvas id="ff-fh" class="field"></canvas>
    </div>
    <div class="cell">
      <div class="celltitle">fuzzy — <span id="ff-fztitle">KDE superlevel set</span> <span class="tag" id="ff-fztag">density, superlevel</span></div>
      <canvas id="ff-fz" class="field"></canvas>
    </div>
    <div class="cell">
      <canvas id="ff-ph" class="pd"></canvas>
      <div class="pdcap"><b style="color:#3b82f6">H₀</b> <span id="ff-h0h">–</span>&nbsp;&nbsp;<b style="color:#ef4444">H₁</b> <span id="ff-h1h">–</span> · spurious bars cluster off the diagonal</div>
    </div>
    <div class="cell">
      <canvas id="ff-pz" class="pd"></canvas>
      <div class="pdcap"><b style="color:#3b82f6">H₀</b> <span id="ff-h0z">–</span>&nbsp;&nbsp;<b style="color:#ef4444">H₁</b> <span id="ff-h1z">–</span> · noise stays near the diagonal</div>
    </div>
  </div>

  <div class="ctrl">
    <button id="ff-play" class="btn" aria-label="pause">⏸</button>
    <span class="lab">sweep</span>
    <input type="range" id="ff-u" min="0" max="1000" step="1" value="0" />
    <span id="ff-uval" class="val">0%</span>
  </div>
</div>

<style>
  .ff-demo { margin: 1rem 0 1.5rem; }
  .ff-demo .row { display:flex; gap:16px; align-items:center; flex-wrap:wrap; margin-bottom:12px; }
  .ff-demo .row.params { gap:18px; padding:9px 12px; border:1px solid var(--sl-color-gray-5); border-radius:8px; background:color-mix(in srgb, var(--sl-color-gray-6) 60%, transparent); }
  .ff-demo .sel { font-size:13px; color:var(--sl-color-gray-2); display:flex; gap:6px; align-items:center; }
  .ff-demo .sel.rng { gap:8px; }
  .ff-demo .sel.rng input[type=range] { width:110px; }
  .ff-demo .val.sm { font-size:13px; min-width:30px; text-align:right; }
  .ff-demo .backend { margin-left:auto; font-size:11px; font-weight:600; letter-spacing:.03em; padding:2px 8px; border-radius:999px; border:1px solid var(--sl-color-gray-5); color:var(--sl-color-gray-2); }
  .ff-demo .backend.gpu { color:#10b981; border-color:#10b981; }
  .ff-demo .chk { cursor:pointer; }
  .ff-demo .chk input { margin:0; }
  .ff-demo select { font-size:13px; padding:3px 6px; background:var(--sl-color-bg); color:var(--sl-color-text); border:1px solid var(--sl-color-gray-5); border-radius:6px; }
  .ff-demo .seg { display:inline-flex; border:1px solid var(--sl-color-gray-5); border-radius:6px; overflow:hidden; }
  .ff-demo .segbtn { font-size:12px; margin:0; padding:3px 9px; background:transparent; color:var(--sl-color-gray-2); border:0; border-left:1px solid var(--sl-color-gray-5); cursor:pointer; }
  .ff-demo .segbtn:first-child { border-left:0; }
  .ff-demo .segbtn.on { background:var(--sl-color-gray-5); color:var(--sl-color-text); }
  .ff-demo .grid2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; align-items:start; }
  @media (max-width: 560px) { .ff-demo .grid2 { grid-template-columns:1fr; } }
  /* zero Starlight's prose top-margin on grid items (it offsets the 2nd column) */
  .ff-demo .cell { display:flex; flex-direction:column; margin-top:0; }
  .ff-demo .celltitle { font-size:12px; font-weight:600; color:var(--sl-color-gray-2); margin-bottom:5px; min-height:16px; line-height:16px; }
  .ff-demo .tag { font-weight:400; color:var(--sl-color-gray-3); font-size:11px; }
  .ff-demo .field, .ff-demo .pd { width:100%; aspect-ratio:1/1; border-radius:8px; background:var(--sl-color-gray-6); display:block; }
  .ff-demo .pdcap { font-size:11px; color:var(--sl-color-gray-3); margin-top:5px; min-height:15px; line-height:15px; }
  .ff-demo .ctrl { display:flex; gap:12px; align-items:center; margin-top:0.9rem; }
  .ff-demo .ctrl input[type=range] { flex:1; }
  .ff-demo .btn { font-size:14px; width:32px; height:30px; display:flex; align-items:center; justify-content:center; border:1px solid var(--sl-color-gray-5); border-radius:6px; background:transparent; color:var(--sl-color-text); cursor:pointer; flex:0 0 auto; }
  .ff-demo .lab { font-size:13px; color:var(--sl-color-gray-2); min-width:42px; }
  .ff-demo .val { font-size:14px; font-weight:600; min-width:42px; text-align:right; }
</style>

<script>
  import { gaussianKdeField, distanceField, dtmField } from '../../../src/spatial/scalarField';
  import { sublevelsetPersistence, fieldBettiNumbers } from '../../../src/spatial/sublevelsetPersistence';
  import type { ScalarField } from '../../../src/spatial/scalarField';
  import type { FieldPersistenceResult } from '../../../src/spatial/sublevelsetPersistence';
  // GPU field generation (compute shader) when the browser exposes WebGPU; the CPU
  // library functions above are the fallback. The persistence reduction is always CPU.
  import { computeFieldGpu, gpuFieldAvailable, isAppleWebKit } from '../lib/gpuField';
  import type { FieldMode } from '../lib/gpuField';

  // ---------------------------------------------------------------------------
  // Theme inks (re-probed on light/dark toggle)
  // ---------------------------------------------------------------------------
  function probe(varName: string, fallback: string): string {
    const el = document.createElement('span');
    el.style.cssText = 'position:absolute;visibility:hidden;';
    el.style.color = `var(${varName})`;
    document.body.appendChild(el);
    const v = getComputedStyle(el).color;
    el.remove();
    return v || fallback;
  }
  let INK = probe('--sl-color-text', '#cbd5e1');
  let DIM = probe('--sl-color-gray-3', '#94a3b8');
  const H0 = '#3b82f6', H1 = '#ef4444';
  // Component palette (same hues as the VR sweep demo).
  const PALETTE = ['#3b82f6', '#f59e0b', '#10b981', '#ef4444', '#8b5cf6', '#ec4899', '#14b8a6', '#eab308'];
  const hexToRgb = (h: string): [number, number, number] => [
    parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16),
  ];
  const PAL_RGB = PALETTE.map(hexToRgb);

  // ---------------------------------------------------------------------------
  // Datasets
  // ---------------------------------------------------------------------------
  type Shape = 'ring' | 'clusters' | 'eight';
  interface Data { xs: number[]; ys: number[]; }

  // Deterministic pseudo-random in [0,1) so the picture is stable across reloads.
  const rand = (q: number) => (Math.sin(q * 91.7) * 4137.1) % 1 * 0.5 + 0.5;

  function makeData(shape: Shape, noise: boolean): Data {
    const xs: number[] = [], ys: number[] = [];
    if (shape === 'ring') {
      for (let i = 0; i < 20; i++) {
        const a = (2 * Math.PI * i) / 20;
        xs.push(9 * Math.cos(a) + (rand(i) - 0.5) * 1.2);
        ys.push(9 * Math.sin(a) + (rand(i + 40) - 0.5) * 1.2);
      }
    } else if (shape === 'clusters') {
      const centres = [[-7, -4], [7, -4], [0, 7]];
      let s = 0;
      for (const [cx, cy] of centres)
        for (let i = 0; i < 9; i++, s++) {
          xs.push(cx + (rand(s) - 0.5) * 4);
          ys.push(cy + (rand(s + 60) - 0.5) * 4);
        }
    } else {
      for (const cx of [-6, 6])
        for (let t = 0; t < 13; t++) {
          const a = (2 * Math.PI * t) / 13;
          xs.push(cx + 5.5 * Math.cos(a) + (rand(t + cx) - 0.5) * 0.9);
          ys.push(5.5 * Math.sin(a) + (rand(t + cx + 20) - 0.5) * 0.9);
        }
    }
    if (noise) {
      // A handful of scattered outliers — the thing hard filtrations mishandle.
      for (let i = 0; i < 7; i++) {
        xs.push((rand(i + 100) - 0.5) * 30);
        ys.push((rand(i + 200) - 0.5) * 30);
      }
    }
    return { xs, ys };
  }

  // ---------------------------------------------------------------------------
  // DOM
  // ---------------------------------------------------------------------------
  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const root = document.querySelector('.ff-demo') as HTMLElement;
  const fhCanvas = byId<HTMLCanvasElement>('ff-fh');
  const fzCanvas = byId<HTMLCanvasElement>('ff-fz');
  const phCanvas = byId<HTMLCanvasElement>('ff-ph');
  const pzCanvas = byId<HTMLCanvasElement>('ff-pz');
  const uInput = byId<HTMLInputElement>('ff-u');
  const uVal = byId<HTMLSpanElement>('ff-uval');
  const playBtn = byId<HTMLButtonElement>('ff-play');
  const dataSel = byId<HTMLSelectElement>('ff-data');
  const noiseChk = byId<HTMLInputElement>('ff-noise');
  const methodBtns = [...root.querySelectorAll<HTMLButtonElement>('#ff-method .segbtn')];
  const fzTitle = byId<HTMLSpanElement>('ff-fztitle');
  const fzTag = byId<HTMLSpanElement>('ff-fztag');
  const h0hOut = byId('ff-h0h'), h1hOut = byId('ff-h1h'), h0zOut = byId('ff-h0z'), h1zOut = byId('ff-h1z');
  const resSel = byId<HTMLSelectElement>('ff-res');
  const falloffInput = byId<HTMLInputElement>('ff-falloff');
  const falloffLabel = byId<HTMLSpanElement>('ff-falloff-label');
  const falloffVal = byId<HTMLSpanElement>('ff-falloff-val');
  const bandInput = byId<HTMLInputElement>('ff-band');
  const bandVal = byId<HTMLSpanElement>('ff-band-val');
  const gpuWrap = byId<HTMLLabelElement>('ff-gpu-wrap');
  const gpuChk = byId<HTMLInputElement>('ff-gpu');
  const backendEl = byId<HTMLSpanElement>('ff-backend');

  // ---------------------------------------------------------------------------
  // Tunable parameters (rebuild the fields + persistence when they change)
  // ---------------------------------------------------------------------------
  let gridN = 64;          // field resolution (N x N)
  let method: 'kde' | 'dtm' = 'kde';
  let sigma = 1.9;         // KDE bandwidth, world units (the "falloff")
  let dtmK = 5;            // DTM neighbours (the "falloff" for DTM)
  let band = 0.08;         // diagram noise band / min-persistence threshold
  let useGpu = false;      // compute fields on WebGPU when available + enabled
  let gpuFellBack = false; // a GPU compute failed this rebuild → showed CPU

  function setBackendBadge(): void {
    const onGpu = useGpu && !gpuFellBack;
    backendEl.textContent = onGpu ? 'WebGPU' : 'CPU';
    backendEl.classList.toggle('gpu', onGpu);
  }

  // ---------------------------------------------------------------------------
  // Built state (rebuilt on shape / outliers / method change)
  // ---------------------------------------------------------------------------
  interface Panel {
    field: ScalarField;
    pers: FieldPersistenceResult;
    superlevel: boolean;   // true: in-set = field >= t; false: field <= t
    sMax: number;          // normalisation scale for the sweep / diagram
    pointCell: number[];   // grid cell index containing each point
  }
  let data: Data;
  let hard: Panel;
  let fuzzy: Panel;
  let bbox: [number, number, number, number];

  function buildPanel(field: ScalarField, superlevel: boolean): Panel {
    const pers = sublevelsetPersistence(field.data, field.width, field.height, { superlevel });
    // Normalisation scale: the peak (superlevel) or the largest finite death (sublevel).
    let sMax = 0;
    if (superlevel) {
      for (const v of field.data) if (v > sMax) sMax = v;
    } else {
      for (const p of pers.pairs) if (isFinite(p.death)) sMax = Math.max(sMax, p.death);
      if (sMax === 0) for (const v of field.data) if (v > sMax) sMax = v;
    }
    sMax = sMax || 1;
    // Map each point to the grid cell containing it (for component colouring).
    const [minX, minY, maxX, maxY] = field.bbox;
    const spanX = (maxX - minX) || 1, spanY = (maxY - minY) || 1;
    const pointCell = data.xs.map((x, i) => {
      const c = Math.min(field.width - 1, Math.max(0, Math.floor(((x - minX) / spanX) * field.width)));
      const r = Math.min(field.height - 1, Math.max(0, Math.floor(((maxY - data.ys[i]!) / spanY) * field.height)));
      return r * field.width + c;
    });
    return { field, pers, superlevel, sMax, pointCell };
  }

  // Generate one field via the active backend (GPU when enabled + available, else
  // the CPU library). Returns a ScalarField regardless of path.
  async function genField(mode: FieldMode): Promise<ScalarField> {
    if (useGpu) {
      const g = await computeFieldGpu(data.xs, data.ys,
        { width: gridN, height: gridN, bbox, mode, sigma, k: dtmK, radiusSigma: 4 });
      if (g) return { data: g, width: gridN, height: gridN, bbox };
      gpuFellBack = true; // WebGPU failed → fall through to CPU, reflect in badge
    }
    if (mode === 'kde')
      return gaussianKdeField(data.xs, data.ys, { width: gridN, height: gridN, sigma, bbox, radiusSigma: 4 });
    if (mode === 'dtm')
      return dtmField(data.xs, data.ys, { width: gridN, height: gridN, bbox, k: dtmK });
    return distanceField(data.xs, data.ys, { width: gridN, height: gridN, bbox });
  }

  // Rebuild fields + persistence. Async (the GPU path awaits a readback); a build
  // token guards against an older rebuild finishing after a newer one.
  let buildSeq = 0;
  async function rebuild(): Promise<void> {
    const seq = ++buildSeq;
    gpuFellBack = false;
    data = makeData(dataSel.value as Shape, noiseChk.checked);
    // Shared framing for both fields, padded so edge kernels/balls aren't clipped.
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    for (let i = 0; i < data.xs.length; i++) {
      minX = Math.min(minX, data.xs[i]!); maxX = Math.max(maxX, data.xs[i]!);
      minY = Math.min(minY, data.ys[i]!); maxY = Math.max(maxY, data.ys[i]!);
    }
    const pad = 3;
    bbox = [minX - pad, minY - pad, maxX + pad, maxY + pad];

    const hardF = await genField('distance');
    const fuzzyF = await genField(method === 'kde' ? 'kde' : 'dtm');
    if (seq !== buildSeq) return; // superseded by a newer rebuild

    hard = buildPanel(hardF, false);
    fuzzy = buildPanel(fuzzyF, method === 'kde');
    setBackendBadge();
    update(u);
  }

  // ---------------------------------------------------------------------------
  // Field rendering: heatmap base + component-coloured set + boundary contour
  // ---------------------------------------------------------------------------
  // Offscreen grid canvas, resized to the current resolution on demand.
  const off = document.createElement('canvas');
  const offCtx = off.getContext('2d')!;

  // Union-find over the in-set grid cells (4-adjacency).
  function labelComponents(mask: Uint8Array, W: number, H: number): Int32Array {
    const parent = new Int32Array(W * H).fill(-1);
    for (let i = 0; i < W * H; i++) if (mask[i]) parent[i] = i;
    const find = (a: number): number => {
      while (parent[a]! !== a) { parent[a] = parent[parent[a]!]!; a = parent[a]!; }
      return a;
    };
    const uni = (a: number, b: number) => {
      const ra = find(a), rb = find(b);
      if (ra !== rb) parent[Math.max(ra, rb)] = Math.min(ra, rb);
    };
    for (let r = 0; r < H; r++)
      for (let c = 0; c < W; c++) {
        const i = r * W + c;
        if (!mask[i]) continue;
        if (c + 1 < W && mask[i + 1]) uni(i, i + 1);
        if (r + 1 < H && mask[i + W]) uni(i, i + W);
      }
    const root = new Int32Array(W * H).fill(-1);
    for (let i = 0; i < W * H; i++) if (mask[i]) root[i] = find(i);
    return root;
  }

  function drawField(canvas: HTMLCanvasElement, panel: Panel, threshold: number): void {
    const { field, superlevel, pointCell } = panel;
    const W = field.width, H = field.height, fd = field.data;
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(rect.width * dpr);
    canvas.height = Math.round(rect.height * dpr);
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const pw = rect.width, ph = rect.height;

    // In-set mask + components.
    const mask = new Uint8Array(W * H);
    for (let i = 0; i < W * H; i++)
      mask[i] = (superlevel ? fd[i]! >= threshold : fd[i]! <= threshold) ? 1 : 0;
    const roots = labelComponents(mask, W, H);
    // Each component's colour = lowest-index point it contains (stable across the
    // sweep; a merge adopts the lower point's colour). Point-free islands → grey.
    const compPoint = new Map<number, number>();
    for (let i = 0; i < pointCell.length; i++) {
      const root = roots[pointCell[i]!]!;
      if (root >= 0) compPoint.set(root, Math.min(compPoint.get(root) ?? Infinity, i));
    }

    // Field range for the faint background shading.
    let lo = Infinity, hi = -Infinity;
    for (let i = 0; i < W * H; i++) { if (fd[i]! < lo) lo = fd[i]!; if (fd[i]! > hi) hi = fd[i]!; }
    const span = (hi - lo) || 1;
    const baseTint = superlevel ? [245, 158, 11] : [59, 130, 246]; // warm fuzzy / cool hard
    const dark = lumOf(INK) > 0.5; // bright ink => dark theme

    if (off.width !== W || off.height !== H) { off.width = W; off.height = H; }
    const offImg = offCtx.createImageData(W, H);
    const px = offImg.data;
    for (let i = 0; i < W * H; i++) {
      const o = i * 4;
      if (mask[i]) {
        const root = roots[i]!;
        const pid = compPoint.get(root);
        const rgb = pid === undefined ? [120, 120, 130] : PAL_RGB[pid % PAL_RGB.length]!;
        px[o] = rgb[0]; px[o + 1] = rgb[1]; px[o + 2] = rgb[2]; px[o + 3] = pid === undefined ? 150 : 205;
      } else {
        // Faint topographic wash of the field (so the landscape is visible).
        const t = (fd[i]! - lo) / span;            // 0..1
        const a = (superlevel ? t : 1 - t) * (dark ? 70 : 50);
        px[o] = baseTint[0]; px[o + 1] = baseTint[1]; px[o + 2] = baseTint[2]; px[o + 3] = a;
      }
    }
    offCtx.putImageData(offImg, 0, 0);
    ctx.clearRect(0, 0, pw, ph);
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(off, 0, 0, pw, ph);

    // Boundary contour at `threshold` (marching squares) — the corners-vs-smooth tell.
    ctx.strokeStyle = INK;
    ctx.globalAlpha = 0.9;
    ctx.lineWidth = 1.6;
    ctx.lineJoin = 'round';
    ctx.beginPath();
    marchingSquares(fd, W, H, threshold, pw, ph, ctx);
    ctx.stroke();
    ctx.globalAlpha = 1;

    // Points.
    const [bx0, by0, bx1, by1] = field.bbox;
    const sx = pw / ((bx1 - bx0) || 1), sy = ph / ((by1 - by0) || 1);
    for (let i = 0; i < data.xs.length; i++) {
      const X = (data.xs[i]! - bx0) * sx;
      const Y = (by1 - data.ys[i]!) * sy;
      ctx.beginPath();
      ctx.arc(X, Y, 2.4, 0, 6.2832);
      ctx.fillStyle = INK;
      ctx.fill();
    }
  }

  function lumOf(c: string): number {
    const m = c.match(/\d+(\.\d+)?/g);
    if (!m) return 0.5;
    const [r, g, b] = m.map(Number);
    return (0.299 * r! + 0.587 * g! + 0.114 * b!) / 255;
  }

  // Marching squares: draw the level set {field = threshold} as line segments,
  // interpolating crossings along grid edges. Sample lattice = the grid centres.
  function marchingSquares(
    fd: ArrayLike<number>, W: number, H: number, thr: number,
    pw: number, ph: number, ctx: CanvasRenderingContext2D,
  ): void {
    const gx = (c: number) => ((c + 0.5) / W) * pw;
    const gy = (r: number) => ((r + 0.5) / H) * ph;
    const lerp = (a: number, b: number, va: number, vb: number) =>
      va === vb ? a : a + (b - a) * ((thr - va) / (vb - va));
    for (let r = 0; r < H - 1; r++)
      for (let c = 0; c < W - 1; c++) {
        const v0 = fd[r * W + c]!,       v1 = fd[r * W + c + 1]!;        // top-left, top-right
        const v2 = fd[(r + 1) * W + c + 1]!, v3 = fd[(r + 1) * W + c]!;  // bottom-right, bottom-left
        let code = 0;
        if (v0 >= thr) code |= 1;
        if (v1 >= thr) code |= 2;
        if (v2 >= thr) code |= 4;
        if (v3 >= thr) code |= 8;
        if (code === 0 || code === 15) continue;
        const x0 = gx(c), x1 = gx(c + 1), y0 = gy(r), y1 = gy(r + 1);
        // Edge crossing points (top, right, bottom, left).
        const top = () => [lerp(x0, x1, v0, v1), y0] as const;
        const right = () => [x1, lerp(y0, y1, v1, v2)] as const;
        const bottom = () => [lerp(x0, x1, v3, v2), y1] as const;
        const left = () => [x0, lerp(y0, y1, v0, v3)] as const;
        const seg = (a: readonly [number, number], b: readonly [number, number]) => {
          ctx.moveTo(a[0], a[1]); ctx.lineTo(b[0], b[1]);
        };
        switch (code) {
          case 1: case 14: seg(left(), top()); break;
          case 2: case 13: seg(top(), right()); break;
          case 3: case 12: seg(left(), right()); break;
          case 4: case 11: seg(right(), bottom()); break;
          case 6: case 9: seg(top(), bottom()); break;
          case 7: case 8: seg(left(), bottom()); break;
          case 5: seg(left(), top()); seg(right(), bottom()); break;   // ambiguous saddle
          case 10: seg(top(), right()); seg(left(), bottom()); break;
        }
      }
  }

  // ---------------------------------------------------------------------------
  // Persistence diagram. Both panels are plotted in a common [0,1] sweep frame:
  // sublevel pairs (hard, DTM) use (birth/sMax, death/sMax); superlevel pairs
  // (KDE) are mapped to "co-density" (1 - birth/peak, 1 - death/peak) so that the
  // sweep crosshair walks the diagonal the same way in both. A feature far ABOVE
  // the diagonal is persistent; near-diagonal points are noise.
  // ---------------------------------------------------------------------------
  interface Pt { dim: number; x: number; y: number; essential: boolean; }

  function normalize(panel: Panel): Pt[] {
    const out: Pt[] = [];
    const s = panel.sMax;
    for (const p of panel.pers.pairs) {
      if (p.dim >= 2) continue;
      if (panel.superlevel) {
        const essential = !isFinite(p.death);              // death = -Inf
        const x = 1 - Math.min(1, p.birth / s);            // co-density birth
        const y = essential ? 1 : 1 - Math.min(1, p.death / s);
        out.push({ dim: p.dim, x, y, essential });
      } else {
        const essential = !isFinite(p.death);
        const x = Math.min(1, p.birth / s);
        const y = essential ? 1 : Math.min(1, p.death / s);
        out.push({ dim: p.dim, x, y, essential });
      }
    }
    return out;
  }

  function drawDiagram(canvas: HTMLCanvasElement, panel: Panel, u: number): [number, number] {
    const pts = normalize(panel);
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(rect.width * dpr);
    canvas.height = Math.round(rect.height * dpr);
    const ctx = canvas.getContext('2d')!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const w = rect.width, h = rect.height, pad = 26;
    const side = Math.min(w, h) - 2 * pad;
    const ox = (w - side) / 2, oy = (h - side) / 2;
    const X = (v: number) => ox + v * side;
    const Y = (v: number) => oy + side - v * side; // death axis up

    ctx.clearRect(0, 0, w, h);

    // Noise band along the diagonal (persistence < `band` = below the threshold).
    ctx.fillStyle = 'rgba(128,128,128,0.12)';
    ctx.beginPath();
    ctx.moveTo(X(0), Y(0)); ctx.lineTo(X(1), Y(1));
    ctx.lineTo(X(1 - band), Y(1)); ctx.lineTo(X(0), Y(band));
    ctx.closePath(); ctx.fill();

    // Axes + diagonal.
    ctx.strokeStyle = 'rgba(128,128,128,0.4)'; ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(X(0), Y(0)); ctx.lineTo(X(1), Y(0));
    ctx.moveTo(X(0), Y(0)); ctx.lineTo(X(0), Y(1));
    ctx.stroke();
    ctx.strokeStyle = 'rgba(128,128,128,0.5)'; ctx.setLineDash([4, 3]);
    ctx.beginPath(); ctx.moveTo(X(0), Y(0)); ctx.lineTo(X(1), Y(1)); ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = DIM; ctx.font = '10px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText('birth →', ox + side / 2, oy + side + 15);
    ctx.save(); ctx.translate(ox - 14, oy + side / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('death →', 0, 0); ctx.restore();

    // Bars; alive (birth ≤ u < death) brighten.
    let b0 = 0, b1 = 0;
    for (const p of pts) {
      if (p.y - p.x < 0.012 && !p.essential) continue; // numerical near-diagonal dust
      const alive = p.x <= u && u < p.y;
      const significant = p.essential || p.y - p.x >= band; // clears the noise band
      if (alive) { if (p.dim === 0) b0++; else b1++; }
      ctx.globalAlpha = alive ? (significant ? 1 : 0.45) : (significant ? 0.32 : 0.16);
      ctx.fillStyle = p.dim === 0 ? H0 : H1;
      const rad = p.dim === 1 ? (alive ? 5 : 3.4) : (alive ? 3.6 : 2.4);
      ctx.beginPath(); ctx.arc(X(p.x), Y(p.y), rad, 0, 6.2832); ctx.fill();
      if (p.essential) {
        ctx.strokeStyle = p.dim === 0 ? H0 : H1; ctx.lineWidth = 1.4;
        ctx.beginPath(); ctx.moveTo(X(p.x), Y(p.y) - 7); ctx.lineTo(X(p.x), Y(p.y) - 1); ctx.stroke();
      }
    }
    ctx.globalAlpha = 1;

    // Sweep crosshair at (u,u).
    ctx.strokeStyle = 'rgba(128,128,128,0.55)'; ctx.setLineDash([2, 3]);
    ctx.beginPath();
    ctx.moveTo(X(u), Y(u)); ctx.lineTo(X(u), Y(1));
    ctx.moveTo(X(0), Y(u)); ctx.lineTo(X(u), Y(u));
    ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = INK; ctx.beginPath(); ctx.arc(X(u), Y(u), 3, 0, 6.2832); ctx.fill();

    return [b0, b1];
  }

  // ---------------------------------------------------------------------------
  // Per-frame update
  // ---------------------------------------------------------------------------
  function update(u: number): void {
    if (!hard || !fuzzy) return; // a rebuild is still in flight
    // Hard: r = u * sMax. Fuzzy KDE: t = (1-u) * peak (descending). Fuzzy DTM: r = u * sMax.
    const hardThr = u * hard.sMax;
    const fuzzyThr = fuzzy.superlevel ? (1 - u) * fuzzy.sMax : u * fuzzy.sMax;
    drawField(fhCanvas, hard, hardThr);
    drawField(fzCanvas, fuzzy, fuzzyThr);
    const [h0h, h1h] = drawDiagram(phCanvas, hard, u);
    const [h0z, h1z] = drawDiagram(pzCanvas, fuzzy, u);
    h0hOut.textContent = String(h0h); h1hOut.textContent = String(h1h);
    h0zOut.textContent = String(h0z); h1zOut.textContent = String(h1z);
    uVal.textContent = Math.round(u * 100) + '%';
    if (document.activeElement !== uInput) uInput.value = String(Math.round(u * 1000));
  }

  // ---------------------------------------------------------------------------
  // Controls + loop
  // ---------------------------------------------------------------------------
  let playing = true, u = 0, startTime: number | null = null;
  const SWEEP_MS = 9000, HOLD_MS = 1200;

  function setPlaying(on: boolean): void {
    playing = on;
    playBtn.textContent = on ? '⏸' : '▶';
    playBtn.setAttribute('aria-label', on ? 'pause' : 'play');
  }
  playBtn.addEventListener('click', () => { setPlaying(!playing); startTime = null; });
  uInput.addEventListener('input', function () {
    setPlaying(false); u = Number(this.value) / 1000; update(u);
  });

  // A new dataset resets the sweep; parameter tweaks keep the current sweep position.
  function rebuildReset(): void { u = 0; startTime = null; setPlaying(true); void rebuild(); }
  dataSel.addEventListener('change', rebuildReset);
  noiseChk.addEventListener('change', rebuildReset);
  resSel.addEventListener('change', () => { gridN = Number(resSel.value); void rebuild(); });

  // Falloff slider — its meaning swaps with the fuzzy method (KDE bandwidth σ vs DTM k).
  function syncFalloff(): void {
    if (method === 'kde') {
      falloffInput.min = '8'; falloffInput.max = '40'; falloffInput.step = '1';
      falloffInput.value = String(Math.round(sigma * 10));
      falloffLabel.innerHTML = 'bandwidth&nbsp;σ';
      falloffVal.textContent = sigma.toFixed(1);
    } else {
      falloffInput.min = '1'; falloffInput.max = '12'; falloffInput.step = '1';
      falloffInput.value = String(dtmK);
      falloffLabel.innerHTML = 'neighbours&nbsp;k';
      falloffVal.textContent = String(dtmK);
    }
  }
  falloffInput.addEventListener('input', function () {
    const v = Number(this.value);
    if (method === 'kde') { sigma = v / 10; falloffVal.textContent = sigma.toFixed(1); }
    else { dtmK = v; falloffVal.textContent = String(dtmK); }
    void rebuild();
  });
  bandInput.addEventListener('input', function () {
    band = Number(this.value) / 1000; bandVal.textContent = band.toFixed(3); update(u);
  });
  gpuChk.addEventListener('change', function () { useGpu = this.checked; void rebuild(); });

  for (const b of methodBtns)
    b.addEventListener('click', () => {
      method = (b.dataset.method as 'kde' | 'dtm') ?? 'kde';
      for (const x of methodBtns) x.classList.toggle('on', x === b);
      fzTitle.textContent = method === 'kde' ? 'KDE superlevel set' : 'distance-to-measure sublevel set';
      fzTag.textContent = method === 'kde' ? 'density, superlevel' : 'DTM, sublevel';
      syncFalloff();
      void rebuild();
    });
  window.addEventListener('resize', () => update(u));

  function applyTheme(): void {
    INK = probe('--sl-color-text', '#cbd5e1');
    DIM = probe('--sl-color-gray-3', '#94a3b8');
    update(u);
  }
  new MutationObserver(applyTheme).observe(document.documentElement, {
    attributes: true, attributeFilter: ['class', 'data-theme'],
  });

  function frame(ts: number): void {
    requestAnimationFrame(frame);
    if (playing) {
      if (startTime === null) startTime = ts;
      const elapsed = (ts - startTime) % (SWEEP_MS + HOLD_MS);
      u = Math.min(1, elapsed / SWEEP_MS);
      update(u);
    }
  }

  // Init: paint immediately on the CPU, then upgrade to WebGPU if the browser has it.
  syncFalloff();
  bandVal.textContent = band.toFixed(3);
  void rebuild();
  gpuFieldAvailable().then((ok) => {
    if (!ok) return;
    gpuWrap.hidden = false;
    // Default the GPU path ON, except on WebKit (Safari/iOS), whose WebGPU backend
    // is stricter and has been crash-prone — leave it opt-in there. (Any bad GPU
    // result also auto-falls-back via output validation in gpuField.ts.)
    const webkit = isAppleWebKit();
    if (webkit) {
      gpuWrap.title = 'WebGPU is experimental on Safari/iOS — may be glitchy; the CPU path is used by default';
      gpuChk.title = gpuWrap.title;
    }
    const on = !webkit;
    gpuChk.checked = on;
    useGpu = on;
    if (on) void rebuild(); // recompute on the GPU (same grids → same diagram)
  });
  requestAnimationFrame(frame);
</script>
