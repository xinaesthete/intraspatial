{
  "name": "intraspatial",
  "version": "0.1.0",
  "type": "module",
  "description": "IntraSpatial — an in-GPU operation-graph runtime and spatial-analysis toolbox on TypeGPU/WebGPU.",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter intraspatial-playground dev",
    "dev:playground": "pnpm --filter intraspatial-playground dev",
    "dev:docs": "pnpm --filter docs-site dev",
    "build:playground": "pnpm --filter intraspatial-playground build",
    "build:docs": "pnpm --filter docs-site build",
    "link:spatialdata": "node scripts/link-spatialdata.mjs",
    "unlink:spatialdata": "node scripts/link-spatialdata.mjs --unlink",
    "build": "pnpm build:lib",
    "build:lib": "vp build -c vite.lib.config.ts && node scripts/guarded.mjs -- tsc -p tsconfig.build.json && node scripts/fix-esm-specifiers.mjs dist",
    "prepack": "pnpm build:lib",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile",
    "check:publish": "node scripts/check-publish.mjs",
    "release": "pnpm build:lib && pnpm --filter @intraspatial/deck build && pnpm check:publish && changeset publish",
    "test": "vp test run && vp test run -c vitest.gpu.config.ts",
    "test:cpu": "vp test run",
    "test:gpu": "vp test run -c vitest.gpu.config.ts",
    "test:watch": "vp test",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:deck && pnpm typecheck:playground",
    "typecheck:core": "node scripts/guarded.mjs -- tsc --noEmit",
    "typecheck:deck": "pnpm --filter @intraspatial/deck typecheck",
    "typecheck:playground": "node scripts/guarded.mjs -- node scripts/tsc-5.mjs --noEmit -p playground/tsconfig.typecheck.json",
    "typecheck:raw": "tsc --noEmit",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint:types": "node scripts/guarded.mjs -- vp lint --type-aware src test packages",
    "lint:fallow": "fallow audit --base main",
    "fallow:report": "fallow dead-code && fallow health --hotspots --targets",
    "fallow:baseline": "fallow dead-code --save-baseline .fallow-baseline/dead-code.json; fallow health --save-baseline .fallow-baseline/health.json; fallow dupes --save-baseline .fallow-baseline/dupes.json; echo baselines saved",
    "format": "vp fmt",
    "mdv:zarr": "tsx scripts/mdv-h5-to-zarr.ts",
    "mdv:parity": "tsx scripts/mdv-pcf-parity.ts",
    "mdv:quadrat": "tsx scripts/mdv-quadrat-parity.ts",
    "umap:obsm": "tsx scripts/umap-obsm.ts",
    "umap:bench": "tsx scripts/umap-bench.ts",
    "qcm:bench": "tsx scripts/qcm-bench.ts",
    "bench:density-precision": "tsx scripts/bench-density-precision.ts",
    "bench:scan": "tsx scripts/bench-scan.ts",
    "bench:grid-index": "tsx scripts/bench-grid-index.ts",
    "bench:assembly": "tsx scripts/bench-tile-assembly.ts"
  },
  "dependencies": {
    "@zarrita/storage": "^0.2.0",
    "geotiff": "^3.0.5",
    "wgpu-matrix": "^3.4.2",
    "zarrita": "^0.7.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.0.0",
    "@webgpu/types": "^0.1.40",
    "fallow": "^3.17.0",
    "openjph-wasm": "^0.1.0",
    "tsx": "^4.23.1",
    "typegpu": "catalog:",
    "typescript": "catalog:",
    "unplugin-typegpu": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "webgpu": "^0.4.0"
  },
  "volta": {
    "node": "24.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinaesthete/intraspatial.git"
  },
  "homepage": "https://xinaesthete.github.io/intraspatial/",
  "keywords": [
    "webgpu",
    "typegpu",
    "spatial-statistics",
    "spatial-biology",
    "gis",
    "operation-graph",
    "gpu"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "@intraspatial/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph": {
      "@intraspatial/source": "./src/gpu/graph/index.ts",
      "types": "./dist/gpu/graph/index.d.ts",
      "default": "./dist/gpu/graph/index.js"
    },
    "./graph/*": {
      "@intraspatial/source": "./src/gpu/graph/*.ts",
      "types": "./dist/gpu/graph/*.d.ts",
      "default": "./dist/gpu/graph/*.js"
    },
    "./device": {
      "@intraspatial/source": "./src/gpu/device.ts",
      "types": "./dist/gpu/device.d.ts",
      "default": "./dist/gpu/device.js"
    },
    "./datasource": {
      "@intraspatial/source": "./src/datasource/index.ts",
      "types": "./dist/datasource/index.d.ts",
      "default": "./dist/datasource/index.js"
    },
    "./geometry": {
      "@intraspatial/source": "./src/geometry/index.ts",
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    },
    "./evo": {
      "@intraspatial/source": "./src/evo/index.ts",
      "types": "./dist/evo/index.d.ts",
      "default": "./dist/evo/index.js"
    },
    "./spatial": {
      "@intraspatial/source": "./src/spatial/index.ts",
      "types": "./dist/spatial/index.d.ts",
      "default": "./dist/spatial/index.js"
    },
    "./color": {
      "@intraspatial/source": "./src/color/index.ts",
      "types": "./dist/color/index.d.ts",
      "default": "./dist/color/index.js"
    },
    "./gpu/spatial": {
      "@intraspatial/source": "./src/gpu/spatial/index.ts",
      "types": "./dist/gpu/spatial/index.d.ts",
      "default": "./dist/gpu/spatial/index.js"
    },
    "./gpu/sim": {
      "@intraspatial/source": "./src/gpu/sim/index.ts",
      "types": "./dist/gpu/sim/index.d.ts",
      "default": "./dist/gpu/sim/index.js"
    },
    "./gpu/interop": {
      "@intraspatial/source": "./src/gpu/interop/index.ts",
      "types": "./dist/gpu/interop/index.d.ts",
      "default": "./dist/gpu/interop/index.js"
    },
    "./*": {
      "@intraspatial/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "typegpu": "^0.11.9",
    "webgpu": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "webgpu": {
      "optional": true
    }
  }
}
