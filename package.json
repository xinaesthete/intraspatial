{
  "name": "intraspatial",
  "version": "0.1.0",
  "type": "module",
  "description": "IntraSpatial — an in-GPU operation-graph runtime and spatial-analysis toolbox on TypeGPU/WebGPU.",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter intraspatial-playground dev",
    "dev:playground": "pnpm --filter intraspatial-playground dev",
    "dev:docs": "pnpm --filter docs-site dev",
    "build:playground": "pnpm --filter intraspatial-playground build",
    "build:docs": "pnpm --filter docs-site build",
    "build": "pnpm build:lib",
    "build:lib": "vite build -c vite.lib.config.ts && node scripts/guarded.mjs -- tsc -p tsconfig.build.json",
    "prepack": "pnpm build:lib",
    "test": "vitest run && vitest run -c vitest.gpu.config.ts",
    "test:cpu": "vitest run",
    "test:gpu": "vitest run -c vitest.gpu.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:playground",
    "typecheck:core": "node scripts/guarded.mjs -- tsc --noEmit",
    "typecheck:playground": "node scripts/guarded.mjs -- node scripts/tsc-5.mjs --noEmit -p playground/tsconfig.typecheck.json",
    "typecheck:raw": "tsc --noEmit",
    "lint": "biome check . && biome check test",
    "lint:fix": "biome check --write . && biome check --write test",
    "lint:fallow": "fallow audit --base main",
    "fallow:report": "fallow dead-code && fallow health --hotspots --targets",
    "fallow:baseline": "fallow dead-code --save-baseline .fallow-baseline/dead-code.json; fallow health --save-baseline .fallow-baseline/health.json; fallow dupes --save-baseline .fallow-baseline/dupes.json; echo baselines saved",
    "format": "biome format --write .",
    "mdv:zarr": "tsx scripts/mdv-h5-to-zarr.ts",
    "mdv:parity": "tsx scripts/mdv-pcf-parity.ts",
    "mdv:quadrat": "tsx scripts/mdv-quadrat-parity.ts",
    "umap:obsm": "tsx scripts/umap-obsm.ts",
    "umap:bench": "tsx scripts/umap-bench.ts",
    "qcm:bench": "tsx scripts/qcm-bench.ts",
    "bench:scan": "tsx scripts/bench-scan.ts",
    "bench:assembly": "tsx scripts/bench-tile-assembly.ts"
  },
  "dependencies": {
    "@zarrita/storage": "^0.2.0",
    "geotiff": "^3.0.5",
    "wgpu-matrix": "^3.4.2",
    "zarrita": "^0.7.3"
  },
  "optionalDependencies": {
    "openjph-wasm": "file:../codecs/openjph-wasm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "^22.0.0",
    "@webgpu/types": "^0.1.40",
    "fallow": "^3.17.0",
    "tsx": "^4.23.1",
    "typegpu": "catalog:",
    "typescript": "catalog:",
    "unplugin-typegpu": "catalog:",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "webgpu": "^0.4.0"
  },
  "volta": {
    "node": "24.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinaesthete/intraspatial.git"
  },
  "homepage": "https://xinaesthete.github.io/intraspatial/",
  "keywords": [
    "webgpu",
    "typegpu",
    "spatial-statistics",
    "spatial-biology",
    "gis",
    "operation-graph",
    "gpu"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph": {
      "types": "./dist/gpu/graph/index.d.ts",
      "default": "./dist/gpu/graph/index.js"
    },
    "./graph/*": {
      "types": "./dist/gpu/graph/*.d.ts",
      "default": "./dist/gpu/graph/*.js"
    },
    "./device": {
      "types": "./dist/gpu/device.d.ts",
      "default": "./dist/gpu/device.js"
    },
    "./datasource": {
      "types": "./dist/datasource/index.d.ts",
      "default": "./dist/datasource/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "default": "./dist/geometry/index.js"
    },
    "./evo": {
      "types": "./dist/evo/index.d.ts",
      "default": "./dist/evo/index.js"
    },
    "./spatial": {
      "types": "./dist/spatial/index.d.ts",
      "default": "./dist/spatial/index.js"
    },
    "./color": {
      "types": "./dist/color/index.d.ts",
      "default": "./dist/color/index.js"
    },
    "./gpu/spatial": {
      "types": "./dist/gpu/spatial/index.d.ts",
      "default": "./dist/gpu/spatial/index.js"
    },
    "./gpu/sim": {
      "types": "./dist/gpu/sim/index.d.ts",
      "default": "./dist/gpu/sim/index.js"
    },
    "./gpu/interop": {
      "types": "./dist/gpu/interop/index.d.ts",
      "default": "./dist/gpu/interop/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "typegpu": "^0.11.9",
    "webgpu": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "webgpu": {
      "optional": true
    }
  }
}
