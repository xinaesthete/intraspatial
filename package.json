{
  "name": "tgpu-htj2k",
  "version": "0.0.0",
  "type": "module",
  "description": "WebGPU HTJ2K (JPEG 2000 Part 15) codec — Rust/wasm CPU core + TypeScript/TypeGPU GPU layer.",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter tgpu-htj2k-playground dev",
    "dev:playground": "pnpm --filter tgpu-htj2k-playground dev",
    "dev:docs": "pnpm --filter docs-site dev",
    "build:playground": "pnpm --filter tgpu-htj2k-playground build",
    "build:docs": "pnpm --filter docs-site build",
    "test": "vitest run && vitest run -c vitest.gpu.config.ts",
    "test:cpu": "vitest run",
    "test:gpu": "vitest run -c vitest.gpu.config.ts",
    "test:watch": "vitest",
    "bench:gpu": "BENCH=1 vitest run -c vitest.gpu.config.ts test/bench_idwt.gpu.test.ts",
    "test:rust": "cargo test --manifest-path rust/htj2k-core/Cargo.toml",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:playground",
    "typecheck:core": "node scripts/guarded.mjs -- tsc --noEmit",
    "typecheck:playground": "node scripts/guarded.mjs -- node scripts/tsc-5.mjs --noEmit -p playground/tsconfig.typecheck.json",
    "typecheck:raw": "tsc --noEmit",
    "lint": "biome check . && biome check test",
    "lint:fix": "biome check --write . && biome check --write test",
    "format": "biome format --write .",
    "build:wasm": "wasm-pack build rust/htj2k-core --target web --out-dir pkg --out-name htj2k_core",
    "build:wasm:dev": "wasm-pack build rust/htj2k-core --dev --target web --out-dir pkg --out-name htj2k_core",
    "mdv:zarr": "tsx scripts/mdv-h5-to-zarr.ts",
    "mdv:parity": "tsx scripts/mdv-pcf-parity.ts",
    "mdv:quadrat": "tsx scripts/mdv-quadrat-parity.ts",
    "umap:obsm": "tsx scripts/umap-obsm.ts",
    "umap:bench": "tsx scripts/umap-bench.ts",
    "qcm:bench": "tsx scripts/qcm-bench.ts"
  },
  "dependencies": {
    "@zarrita/storage": "^0.2.0",
    "geotiff": "^3.0.5",
    "typegpu": "catalog:",
    "webgpu": "^0.4.0",
    "wgpu-matrix": "^3.4.2",
    "zarrita": "^0.7.3"
  },
  "optionalDependencies": {
    "openjph-wasm": "file:../openjph-wasm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "^22.0.0",
    "@webgpu/types": "^0.1.40",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "unplugin-typegpu": "catalog:",
    "vitest": "^4.1.10"
  },
  "volta": {
    "node": "22.23.1"
  }
}
