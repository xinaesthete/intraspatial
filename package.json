{
  "name": "intraspatial",
  "version": "0.0.0",
  "type": "module",
  "description": "IntraSpatial \u2014 an in-GPU operation-graph runtime and spatial-analysis toolbox on TypeGPU/WebGPU.",
  "license": "MIT",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter intraspatial-playground dev",
    "dev:playground": "pnpm --filter intraspatial-playground dev",
    "dev:docs": "pnpm --filter docs-site dev",
    "build:playground": "pnpm --filter intraspatial-playground build",
    "build:docs": "pnpm --filter docs-site build",
    "test": "vitest run && vitest run -c vitest.gpu.config.ts",
    "test:cpu": "vitest run",
    "test:gpu": "vitest run -c vitest.gpu.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm typecheck:core && pnpm typecheck:playground",
    "typecheck:core": "node scripts/guarded.mjs -- tsc --noEmit",
    "typecheck:playground": "node scripts/guarded.mjs -- node scripts/tsc-5.mjs --noEmit -p playground/tsconfig.typecheck.json",
    "typecheck:raw": "tsc --noEmit",
    "lint": "biome check . && biome check test",
    "lint:fix": "biome check --write . && biome check --write test",
    "format": "biome format --write .",
    "mdv:zarr": "tsx scripts/mdv-h5-to-zarr.ts",
    "mdv:parity": "tsx scripts/mdv-pcf-parity.ts",
    "mdv:quadrat": "tsx scripts/mdv-quadrat-parity.ts",
    "umap:obsm": "tsx scripts/umap-obsm.ts",
    "umap:bench": "tsx scripts/umap-bench.ts",
    "qcm:bench": "tsx scripts/qcm-bench.ts"
  },
  "dependencies": {
    "@zarrita/storage": "^0.2.0",
    "geotiff": "^3.0.5",
    "typegpu": "catalog:",
    "webgpu": "^0.4.0",
    "wgpu-matrix": "^3.4.2",
    "zarrita": "^0.7.3"
  },
  "optionalDependencies": {
    "openjph-wasm": "file:../codecs/openjph-wasm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "^22.0.0",
    "@webgpu/types": "^0.1.40",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "unplugin-typegpu": "catalog:",
    "vitest": "^4.1.10"
  },
  "volta": {
    "node": "24.18.0"
  }
}
