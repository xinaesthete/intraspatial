{ 'RESETGOALS' function #
  OName := ?sref;
  /* clears all the goals of object OName */
 
  CurObj := Objects@OName;
 
  CurObj.Goals:= array_of(DefGoal, 1, 0);
 
  Objects@OName := CurObj;
};
 
{ 'RESETGOALS' function #
  dummy := ?stmt;
  /* resets the goals of all objetcs (including inactive ones) */
 
  ONum:= 0;
  do(ONum, 1, number(Objects),
   if ONum=1 then OName := first(Objects,'');
             else OName := next(Objects,OName);
   ResetGoals(OName);
   ); /* end ONum loop */
};
 
/*---------------------------------------------------------------------*/
 
{ 'REMOVEGOAL' function #
  OName := ?sref;
  GName := ?sref;
  /* removes a goal with a given name */
  /* it might be workth improving this function in future */
 
  if OName^='' then begin
   GoalNum := NewGoal(OName, GName);
   CurObj  := Objects@OName;
   CurGoal := (CurObj.Goals)@GoalNum;
   CurGoal.Active := false;
   (CurObj.Goals)@GoalNum := CurGoal;
   Objects@OName := CurObj;
  end;
 
};
 
