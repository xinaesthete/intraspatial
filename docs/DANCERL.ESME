/*---------------------------------------------------------------------*/
/* Functions to set up goals for objects                               */
/*---------------------------------------------------------------------*/
 
{ 'NEWGOAL' function #
  OName    := ?sref;
  GoalName := ?sref;
  /* checks Object OName see if there is already a */
  /* goal with the given name. If there is it returns a pointer to */
  /* this goal, otherwise a new goal is added and a pointer to this */
  /* is returned. Note: if the name '' is supplied then a new goal is */
  /* always added */
 
  CurObj   := Objects@OName;
 
  GoalNum  := 0;
  Match    := false;
 
  if GoalName^='' then
   while( (^Match) & (GoalNum<highbound(CurObj.Goals)),
    GoalNum := GoalNum + 1;
    if GoalName=((CurObj.Goals)@GoalNum).GoalName then Match := true;
    );
 
  if ^Match then
   begin
    CurGoal          := DefGoal;
    CurGoal.GoalName := GoalName;
    CurObj.Goals     := CurObj.Goals › CurGoal;
    GoalNum          := highbound(CurObj.Goals);
    Objects@OName    := CurObj;
   end;
 
  GoalNum
};
 
/*---------------------------------------------------------------------*/
 
{ 'SETPOSVELGOAL' function #
  OName  := ?sref;
  GPos   := ?vec;
  GVel   := ?vec;
  GTime  := ?float;
  Start  := ?float;
  Finish := ?float;
  GName  := ?sref;
  /* sets a linear goal of reaching point GPos with velocity GVel at */
  /* time GTime */
 
  GoalNum := NewGoal(OName, GName);
 
  CurObj  := Objects@OName;
  CurGoal := (CurObj.Goals)@GoalNum;
 
  CurObj  := Objects@OName;
 
  CurGoal.GoalSort   := 'LINPOSVEL';
  CurGoal.Pos        := GPos;
  CurGoal.Vel        := GVel;
  CurGoal.GoalTime   := GTime;
  CurGoal.StartAct   := Start;
  CurGoal.StartTight := GTime-50;
  CurGoal.FinishAct  := Finish;
  CurGoal.Active     := true;
 
  (CurObj.Goals)@GoalNum := CurGoal;
 
  Objects@OName := CurObj;
};
 
