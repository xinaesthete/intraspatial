/*---------------------------------------------------------------------*/
 
{ 'SETBASICINFLUENCES' function #
  dummy := ?stmt;
  /* sets basic influences for lifecycl objects */
 
  ONum:= 0;
  do(ONum, 1, number(Objects),
   if ONum=1 then OName := first(Objects,'');
             else OName := next(Objects,OName);
   i := 0;
   do(i, 1, highbound( (Objects@OName).Points ),
    SetCollision(OName,i,1);
    );
   SetConstraint(OName,0,1);
   ); /* end ONum loop */
 
};
 
/*---------------------------------------------------------------------*/
/* Function to calculate object mass, centre of gravity, inertia etc.. */
/*---------------------------------------------------------------------*/
 
{ 'CALCMASSCENTRE' function #
  OName := ?sref;
  /* Calcultes the mass, centre of gravity, inertia of a given object */
 
  CurObj := Objects@OName;
  PNum   := 0;
  TotM   := 0;
  TotMxP := (0,0,0);
 
  /* loop though points other than centre */
  do(PNum, 1, highbound(CurObj.Points),
   TotM   := TotM + ((CurObj.Points)@PNum).Mass;
   TotMxP := TotMxP
         + ((CurObj.Points)@PNum).Mass * ((CurObj.Points)@PNum).OrigPos;
   );
 
  if TotM=0
   then begin
    say 'WARNING! Zero Mass for entire object !!!!';
    ToTM:= 0.000000001;
    COG := (0,0,0);
   end;
   else COG := TotMxP / TotM;
 
   CurObj.Mass := TotM;
 
   CurObj.Inertia := TotM;
   CurObj.InvIner := 1/CurObj.Inertia;
 
   CentrePoint := (CurObj.Points)@0; /* point 0 reserved for centre */
   CentrePoint.OrigPos := COG;
   CentrePoint.Mass    := TotM; /* total mass to centre of gravity */
   (CurObj.Points)@0 := CentrePoint;
 
   Objects@OName:= CurObj; /* place info back into Objects */
};
 
{ 'CALCMASSCENTRE' function #
  dummy := ?stmt;
  /* if called with no parameter, then calculate for all objects */
  /* (including currently inactive ones) */
 
  ONum:= 0;
  do(ONum, 1, number(Objects),
   if ONum=1 then OName := first(Objects,'');
             else OName := next(Objects,OName);
   CalcMassCentre(OName);
   ); /* end ONum loop */
};
 
/*---------------------------------------------------------------------*/
 
{ 'CALCMOMENTUM' function #
  OName     := ?sref;
  /* Calculates the linear and angular momentum of object OName given */
  /* the last two transformations, over time step TimeStep */
 
  /* Note: centre of gravity of object must be already calculated */
  /*       by a call to CALCMASSCENTRE */
 
  CurObj := Objects@OName;
  Centre:= ((CurObj.Points)@0).OrigPos; /* point 0 reserved for centre */
 
  LinVel := ((Centre CurObj.TotTrans) - (Centre CurObj.PreTrans))
         / CurObj.LastTS;
  CurObj.LinMom := LinVel * CurObj.Mass;
  CurObj.LinVel := LinVel;
  CurObj.LinPos := Centre CurObj.TotTrans;
 
  DRot  := Rotate(CurObj.TotTrans) inv(Rotate(CurObj.PreTrans));
  Quat  := Mat2Quat(DRot);
  Theta := acos(Quat.q0);
  if (Theta=0) then AngVel:= (0,0,0);
   else AngVel:= 2*Theta * (Quat.q1,Quat.q2,Quat.q3) / sin(Theta)
                 / CurObj.LastTS;
  CurObj.AngVel := AngVel;
  CurObj.AngMom :=CurObj.Inertia * AngVel; /* should be tensor */
 
  /* calculate angular position vector */
  Quat := Mat2Quat(Rotate(CurObj.TotTrans));
  Theta := acos(Quat.q0);
  if (Theta=0) then AngPos:= (0,0,0);
   else AngPos := 2*Theta * (Quat.q1,Quat.q2,Quat.q3) / sin(Theta);
  CurObj.AngPos := AngPos;
 
  if (DanceTrace>=1) then
   begin
    say 'Calc Linear Velocity :' LinVel;
    say 'Calc Angular Velocity :' AngVel;
    say 'Calc Linear Momentum :' CurObj.LinMom;
    say 'Calc Angular Momentum :' CurObj.AngMom;
   end;
 
  Objects@OName := CurObj;
};
 
{ 'CALCMOMENTUM' function #
  dummy := ?stmt;
  /* if called with no parameter, then calculate for all objects */
  /* (including currently inactive ones) */
 
  ONum:= 0;
  do(ONum, 1, number(Objects),
   if ONum=1 then OName := first(Objects,'');
             else OName := next(Objects,OName);
   CalcMomentum(OName);
   ); /* end ONum loop */
};
 
/*---------------------------------------------------------------------*/
 
{ 'CALCPOINTPOSITIONS' function #
  OName:= ?sref;
  /* sets the positions of the points in object OName by applying */
  /* TotTrans to each of the original point positions */
 
  CurObj := Objects@OName;
 
  PNum := 0;
  do(PNum, 0, highbound(CurObj.Points),
   CurPoint := (CurObj.Points)@PNum;
   CurPoint.Pos := CurPoint.OrigPos CurObj.TotTrans;
   (CurObj.Points)@PNum:= CurPoint;
   );
 
  CurObj.LinPos := ((CurObj.Points)@0).Pos;
 
  Objects@OName := CurObj;
};
 
{ 'CALCPOINTPOSITIONS' function #
  dummy := ?stmt;
  /* sets the positions of the points of all the objects by applying */
  /* TotTrans to each of the original points */
  /* (including currently inactive ones) */
 
  ONum:= 0;
  do(ONum, 1, number(Objects),
   if ONum=1 then OName := first(Objects,'');
             else OName := next(Objects,OName);
   CalcPointPositions(OName);
   ); /* end ONum loop */
};
 
/*---------------------------------------------------------------------*/
/* Activity Functions                                                  */
/*---------------------------------------------------------------------*/
 
{ 'NEWLYACTIVE' function #
  OName := ?sref;
  /* takes last two transforms from movie scene to calculate object's */
  /* current linear and angular momentum */
 
  if (DanceTrace>=1) then say 'Calculating Newly Active Object' OName;
 
  CurObj:= Objects@OName;
  PName := ParentName(OName);
 
  if ^CurObj.TransSet then begin
   if UseDancerPreview
    then begin
     if PName^='' then
      begin
       CurObj.PreTrans := CurObj.PreBirth (Objects@PName).PreTrans;
       CurObj.TotTrans := CurObj.TotBirth (Objects@PName).TotTrans;
      end;
    end;
 
    else begin
     CurObj.PreTrans := (movie_sc.list@OName).prev_trans;
     say 'Prev_Trans : ' CurObj.PreTrans;
     CurObj.TotTrans := (movie_sc.list@OName).this_trans;
     say 'This_Trans : ' CurObj.TotTrans;
 
     PName := ParentName(OName);
     if PName^='' then
      begin
       CurObj.PreBirth := CurObj.PreTrans
                          inv( (Objects@PName).PreTrans );
       CurObj.TotBirth := CurObj.TotTrans
                          inv( (Objects@PName).TotTrans );
      end;
    end;
  end;
 
  Objects@OName := CurObj;
 
  if CurObj.UsesDancerApprox then begin
   if DanceTrace>=2 then say 'About to Calculate Dancer Approx of' OName;
   Dancer_Approx(OName);
  end;
  if DanceTrace>=2 then say 'About to Calculate Mass & Centre of' OName;
  CalcMassCentre(OName);
  if DanceTrace>1 then say 'About to Calculate point positions of' OName;
  CalcPointPositions(OName);
  if DanceTrace>=2 then say 'About to Calculate momentum of ' OName;
  CalcMomentum(OName);
 
  if CurObj.BecomesCentre then begin
   CentreOfAttention := OName;
   if DanceTrace>=1 then say 'Making ' OName ' Centre Of Attention ';
  end;
 
  if DanceTrace>=1 then say 'Finished Calculating Newly Active Object';
};
 
/*---------------------------------------------------------------------*/
 
{ 'OLDACTIVE' function #
  OName := ?sref;
  /* calculates new positions from lifecycle for an object that is */
  /* already active */
 
  if (Objects@OName).UsesDancerApprox then begin
   if DanceTrace>=3 then say 'Calculating Old Active Object' OName;
   Dancer_Approx(OName);
   CurObj := Objects@OName;
 
   OldCentre := ((CurObj.Points)@0).Pos;
   NewCentre := ((CurObj.Points)@0).OrigPos CurObj.TotTrans;
   /* translate so new centre placed at old */
   CurObj.TotTrans := CurObj.TotTrans at(OldCentre - NewCentre);
   Objects@OName := CurObj;
 
   CalcMassCentre(OName);
   CalcPointPositions(OName);
  end;
 
};
 
/*---------------------------------------------------------------------*/
 
{ 'CALCACTIVEOBJ' function #
  FrNum := ?float;
  /* calculates the active objects at frame number FrNum */
  /* if an object has just become active it calcualtes it momentum */
  /* from last two transforms in movie scene */
 
  ActiveObj:= array_of('', 1, 0); /* empty list of active objects */
 
  ONum := 0;
  do(ONum, 1, number(Objects),
   if ONum=1 then OName:= first(Objects,'');
             else OName:= next(Objects,OName);
 
   CurObj := Objects@OName;
   StartA := CurObj.StartAct;
   EndA   := CurObj.EndAct;
   FullyA := CurObj.FullyAct;
 
   if (FrNum>=StartA)&(FrNum<=EndA) then
    begin
     ActiveObj := ActiveObj › OName; /* make object active */
     CurObj.SelfActiv := COSTVUP( StartA, StartA + FullyA, FrNum );
     CurObj.Activity := CurObj.SelfActiv
                        * COSTVDOWN( EndA - FullyA, EndA, FrNum );
     Objects@OName:= CurObj; /* place info back into lookup */
 
     if (FrNum=StartA) then NewlyActive(OName);
                       else OldActive(OName);
 
    end;
 
   ); /* end do ONum loop */
 
};
 
/*---------------------------------------------------------------------*/
 
{ 'OLDCALCACTIVEOBJ' function #
  FrNum := ?float;
  /* calculates the active objects at frame number FrNum */
  /* if an object has just become active it calcualtes it momentum */
  /* from last two transforms in movie scene */
 
  ActiveObj:= array_of('', 1, 0); /* empty list of active objects */
 
  ONum:= 0;
  do(ONum, 1, number(Objects),
   if ONum= 1 then OName:= first(Objects,'');
              else OName:= next(Objects,OName);
 
   CurObj := Objects@OName;
   StartA := CurObj.StartAct;
   EndA   := CurObj.EndAct;
   FullyA := CurObj.FullyAct;
 
   if (FrNum>=StartA)&(FrNum<=EndA) then
    begin
     ActiveObj:= ActiveObj › OName; /* make object active */
     CurObj.SelfActiv := COSTVUP( StartA, StartA + FullyA, FrNum );
     CurObj.Activity := CurObj.SelfActiv
                        * COSTVDOWN( EndA - FullyA, EndA, FrNum );
     Objects@OName:= CurObj; /* place info back into lookup */
    end;
 
   ); /* end do ONum loop */
 
};
 
/*---------------------------------------------------------------------*/
/* General Utilities                                                   */
/*---------------------------------------------------------------------*/
 
{ 'DANCECSG' function #
  OName := ?sref;
  /* creates a simple ball representation CSG object for a FullObj */
 
  CurObj    := Objects@OName;
  ResultCSG := empty;
  PNum      := 0;
 
  do(PNum, 1, highbound(CurObj.Points),
   CurPoint := (CurObj.Points)@PNum;
   ResultCSG:= ResultCSG union
   ( sphere(CurPoint.Rad) at(CurPoint.Pos) );
   );
 
      /*
  ResultCSG := sphere(1) at(((CurObj.Points)@0).Pos) union empty;
      */
 
  ResultCSG
};
 
{ 'DANCECSG' function #
  dummy := ?stmt;
  /* constructs csg object to represent all active dancer objects */
 
  Result:= empty;
 
  Obj1 := 0;
  do(Obj1, 1, highbound(ActiveObj),
   CurObjName := ActiveObj@Obj1;
   Result:= Result union DanceCsg(CurObjName);
   );
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'SAYINFLUENCE' function #
  CurInf := ?InfType;
 
  say '  Type     ' CurInf.InfSort;
  say '  Scope    ' CurInf.Scope;
  say '  Parm1    ' CurInf.Parm1;
  say '  Parm2    ' CurInf.Parm2;
  say '  Vec1     ' CurInf.Vec1;
  say '  SecObj   ' CurInf.SecObj;
  say '  SecPoint ' CurInf.SecPoint;
 
};
 
/*---------------------------------------------------------------------*/
 
{ 'SAYPOINT' function #
  OName := ?sref;
  PNum  := ?float;
 
  CurObj   := Objects@OName;
  CurPoint := (CurObj.Points)@PNum;
 
  say 'Object ' OName ' Point ' PNum;
  say ' Pos     ' CurPoint.Pos;
  say ' Mass    ' CurPoint.Mass;
  say ' Force   ' CurPoint.Force;
  say ' OrigPos ' CurPoint.OrigPos;
  say ' Rad     ' CurPoint.Rad;
  say ' Influences :';
 
  i:= 0;
  do(i, 1, highbound(CurPoint.Influences),
   CurInf := (CurPoint.Influences)@i;
   say ' Influence ' i;
   Sayinfluence(CurInf);
   );
 
};
 
/*---------------------------------------------------------------------*/
 
{ 'SAYOBJECT' function #;
  OName := ?sref;
 
  CurObj := Objects@OName;
 
  say 'Object ' OName;
  say ' Activity  ' CurObj.Activity;
  say ' SelfActiv ' CurObj.SelfActiv;
  say ' CentOfAtt ' CurObj.BecomesCentre;
  say ' StartAct  ' CurObj.StartAct;
  say ' Density   ' CurObj.Density;
  say ' Mass      ' CurObj.Mass;
  say ' Inertia   ' CurObj.Inertia;
  say ' InvIner   ' CurObj.InvIner;
  say ' LinDamp   ' CurObj.LinDamp;
  say ' AngDamp   ' CurObj.AngDamp;
  say ' LinMom    ' CurObj.LinMom;
  say ' AngMom    ' CurObj.AngMom;
  say ' LinVel    ' CurObj.LinVel;
  say ' AngVel    ' CurObj.AngVel;
  say ' LastTS    ' CurObj.LastTS;
  say ' TotTrans  ' CurObj.TotTrans;
  say ' PreTrans  ' CurObj.PreTrans;
  say ' TotBirth  ' CurObj.TotBirth;
  say ' PreBirth  ' CurObj.PreBirth;
 
};
 
/*---------------------------------------------------------------------*/
 
{ 'SAYOBJECTPOINTS' function #
  OName := ?sref;
 
  say 'Object ' OName;
 
  i:= 0;
  do(i, 0, highbound( (Objects@OName).Points ),
   SayPoint(OName,i);
   );
 
};
 
/*---------------------------------------------------------------------*/
 
{ 'SAYOBJECTNAMES' function #
  OName := ?sref;
 
  say 'Current Dancer Objects :';
  ONum:= 0;
  do(ONum, 1, number(Objects),
   if ONum= 1 then OName:= first(Objects,'');
              else OName:= next(Objects,OName);
  say '  ' OName;
  );
 
};
 
/*---------------------------------------------------------------------*/
 
{ 'PUTNUMBER' function #
  tt := ?float;
  ff := ?file;
 
  put(string(tt)||' ',ff);
};
 
{ 'PUTTRANS' function #
  tt := ?trans;
  ff := ?file;
 
  putnumber(tt.r11,ff);
  putnumber(tt.r12,ff);
  putnumber(tt.r13,ff);
  putnumber(tt.r21,ff);
  putnumber(tt.r22,ff);
  putnumber(tt.r23,ff);
  putnumber(tt.r31,ff);
  putnumber(tt.r32,ff);
  putnumber(tt.r33,ff);
  putnumber(tt.p1,ff);
  putnumber(tt.p2,ff);
  putnumber(tt.p3,ff);
  putnumber(tt.s,ff);
 
};
 
{ 'GETTRANS' function #
  ff := ?file;
 
  tt:= unitt;
  tt.r11:= getnumber(ff);
  tt.r12:= getnumber(ff);
  tt.r13:= getnumber(ff);
  tt.r21:= getnumber(ff);
  tt.r22:= getnumber(ff);
  tt.r23:= getnumber(ff);
  tt.r31:= getnumber(ff);
  tt.r32:= getnumber(ff);
  tt.r33:= getnumber(ff);
  tt.p1:= getnumber(ff);
  tt.p2:= getnumber(ff);
  tt.p3:= getnumber(ff);
  tt.s:= getnumber(ff);
 
  tt
};
 
{ 'SAVE_BIRTH' function #
  fname := ?sref;
 
  ff:= fopen(fname,'w');
 
  ONum := 0;
  do(ONum, 1, number(Objects),
   if ONum=1 then OName:= first(Objects,'');
             else OName:= next(Objects,OName);
   CurObj:= Objects@OName;
   put(OName||' ',ff);
   puttrans(CurObj.PreBirth,ff);
   puttrans(CurObj.TotBirth,ff);
   );
 
  fclose(ff);
 
};
 
{ 'LOAD_BIRTH' function #
  fname := ?sref;
 
  ff:= fopen(fname,'r');
 
  ONum := 0;
  do(ONum, 1, number(Objects),
   OName:= getstring(ff);
   CurObj:= Objects@OName;
   CurObj.PreBirth := gettrans(ff);
   CurObj.TotBirth := gettrans(ff);
   Objects@OName := CurObj;
   );
 
  fclose(ff);
 
};
 
 
 
/*---------------------------------------------------------------------*/
/* Functions to reset objects & transforms                             */
/*---------------------------------------------------------------------*/
 
{ 'RESETOBJECTS' function #
  dummy := ?stmt;
  /* sets object lookup to zero */
 
  ONum := 0;
  do(ONum, 1, number(Objects),
   if ONum=1 then OName:= first(Objects,'');
             else OName:= next(Objects,OName);
 
  Objects@OName := DefFullObj;
  );
 
  Objects:= lookup_of(DefFullObj);
 
};
 
/*---------------------------------------------------------------------*/
 
{ 'RESETTRANSFORMS' function #
  dummy := ?stmt;
  /* set all the object transforms to zero */
  /* (including currently inactive ones */
 
  ONum:= 0;
  do(ONum, 1, number(Objects),
   if ONum=1 then OName:= first(Objects,'');
             else OName:= next(Objects,OName);
   CurObj          := Objects@OName;
   CurObj.TotTrans := at(0,0,0);
   Objects@OName   := CurObj;
   ); /* end ONum loop */
};
 
{ 'RESETINFLUENCES' function #
  dummy := ?stmt;
  /* set all the object influences to zero */
  /* (including currently inactive ones */
 
  ONum := 0;
  PNum := 0;
 
  do(ONum, 1, number(Objects),
   if ONum=1 then OName := first(Objects,'');
             else OName := next(Objects,OName);
   CurObj := Objects@OName;
 
   do(Pnum, 0, highbound(CurObj.Points),
    CurPoint             := (CurObj.Points)@PNum;
    CurPoint.Influences  := array_of(DefInf, 1, 0);
    (CurObj.Points)@Pnum := CurPoint;
    );
 
   Objects@OName := CurObj;
   ); /* end ONum loop */
};
 
/*---------------------------------------------------------------------*/
/* Main Function : DANCESTEP & DANCETRANS                              */
/*---------------------------------------------------------------------*/
 
{ 'DANCESTEP' function #
  FrNum   := ?float; /* the current frame number */
 
  NumSteps:= 1;
  /* Does all the calculations for a single frame step */
  if DanceTrace>=1 then say 'Doing Dancer step for frame ' FrNum;
 
  if DanceTrace>=2 then say 'About to calculate active objects';
  CalcActiveObj(FrNum); /* Calculate which objects are active */
                        /* and set their activity levels */
 
  if highbound(ActiveObj)^=0 then /* check at least one obj active */
   begin
 
    ONum := 0;
    do(ONum, 1, highbound(ActiveObj),
     OName  := ActiveObj@ONum;
     CurObj := Objects@OName;
     CurObj.PreTrans:= CurObj.TotTrans;
     Objects@OName := CurObj;
     );
 
    loop := 0;
    do(loop, 0, NumSteps-1,
     if DanceTrace>=2 then say 'About to calculate forces';
     CalcForces();
     if DanceTrace>=2 then say 'About to apply forces';
     ApplyForces( 1/NumSteps, (FrNum + loop/NumSteps) );
     );
   end;
 
  if DanceTrace>=1 then begin
   say 'Camera Distance :' length((Objects@'camera').LinPos);
   say 'Focus Distance :' length((Objects@'focus').LinPos);
  end;
 
  if DanceTrace>=1 then say 'Finishing DanceStep';
 
 };
add_defaults('DANCESTEP','float, float=1');
 
/*---------------------------------------------------------------------*/
 
{ 'OLDDANCESTEP' function #
  FrNum   := ?float; /* the current frame number */
  NumSteps:= ?float; /* number of sub steps for each frame */
  Recalc  := ?bool; /* recalculate c.o.g. & momentum from positions? */
  /* Does all the calculations for a single frame step */
 
  if Recalc then CalcMassCentre();
 
  OldCalcActiveObj(FrNum); /* Calculate which objects are active */
                           /* and set their activity levels */
 
  if highbound(ActiveObj)^=0 then /* check at least one obj active */
 
  loop := 0;
 
  do(loop, 0, NumSteps-1,
   DanceStepCSG := empty;
   CalcForces();
   ApplyForces( 1/NumSteps, (FrNum + loop/NumSteps) );
   );
 };
 
add_defaults('OLDDANCESTEP','float, float=1, bool=false');
 
/*---------------------------------------------------------------------*/
 
{ 'DANCETRANS' function #
  OName:= ?sref;
  /* returns the current transformation for object OName */
 
  (Objects@OName).TotTrans
};
 
/*---------------------------------------------------------------------*/
 
{ 'DANCER' function #
  dummy := ?stmt;
  /* The function for Movie to call as a motion to set the transform */
 
  trns := (Objects@(movie_sc.current_name)).TotTrans;
 
  movie_sc.current_item := movie_sc.current_item tr2item(trns);
 
};
 
