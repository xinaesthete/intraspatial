/*---------------------------------------------------------------------*/
/* DANCERL : Pseudo field based very high level movement control       */
/*           Special hacked version to work with Movie & Lifecycl      */
/*           for William's SIGGRAPH film                               */
/*                                                                     */
/* Written by Andy Lomas : Started 27.04.92                            */
/*                         Last Modified 26.06.92                      */
/*---------------------------------------------------------------------*/
 
/*---------------------------------------------------------------------*/
/* Notes : This version uses frame numbers as the basic unit of time   */
/*---------------------------------------------------------------------*/
 
/*---------------------------------------------------------------------*/
/* Force Influences: Each point holds a list of all the forces which   */
/*                   currently influence it                            */
/*                                                                     */
/*                                                                     */
/* Currently Implemented Force Influences:                             */
/*                                                                     */
/* SetCollision(OName,PNum,Str)                                        */
/*  - sets the strength of collision force at Object OName point PNum  */
/*    to Str                                                           */
/*                                                                     */
/* SetRadius(OName,PNum,Rad)                                           */
/*  - sets the radius of object OName at point PNum to Rad             */
/*                                                                     */
/* SetDistance(O1Name,P1Num,O2Name,P2Num,Dist,Str                      */
/*  - sets the distance Dist that Object O1Name at point P1Num tries   */
/*    to maintain from object O2Name at point P2Num with strength Str  */
/*                                                                     */
/* SetConstraint(OName,PNum,Str)                                       */
/*  - sets the strength with which object OName at point PNum is       */
/*    affected by the global constraining force to Str                 */
/*                                                                     */
/* SetSolenoid(OName,PNum,Str)                                         */
/*  - sets the strength with which object OName at point PNum is       */
/*    affected by a single coil solenoid pattern force                 */
/*                                                                     */
/* SetCircle(OName,PNum,Str)                                           */
/*  - sets the strength with which object OName at point PNum is       */
/*    affected by a circular stiring force (about the y axis)          */
/*                                                                     */
/* SetOrbit(OName,PNum,Str)                                            */
/*  - sets the strength with which object OName at point PNum tends    */
/*    to orbit around the centre of the scene                          */
/*                                                                     */
/* SetOrbit(O1Name,P1Num,O2Name,P2Num,Str)                             */
/*  - sets the strength with which object O1Name at point P1Num tends  */
/*    to orbit around object O2Name at point P2Num                     */
/*                                                                     */
/*                                                                     */
/* Functions to reset Forces Influences etc...                         */
/*                                                                     */
/* ResetObjects()                                                      */
/*  - resets the object list to zero                                   */
/*                                                                     */
/* ResetInfluences                                                     */
/*  - resets all the point influence lists to zero                     */
/*                                                                     */
/*---------------------------------------------------------------------*/
 
TimeFactor := 0.2; /* used to scale between different timescales */
DanceTrace := 0;
DrawHermite := true ;
CentreOfAttention := '';
LastCentreAccel := (0,0,0);
DanceStepCSG := empty;
 
public_UseDancerPreview := false;
 
now(cread('movie'));
 
now(DefInf:= new(InfType,
                 InfName   := ''; /* user's name for influence */
                 InfSort   := ''; /* the sort of influence */
                 Scope     := ''; /* whether influence is global,  */
                                    /* from all points, or one point */
                 Parm1     := 0;  /* Parameters, used by different */
                 Parm2     := 0;  /* influences in different ways  */
                 Vec1      := (0,0,0);
                 SecObj    := ''; /* Name and position of second */
                 SecPoint  := 0;  /* point for ONEPOINT forces */
                ) );
 
now(arrutils('InfType') );
 
now(DefPoint:= new(PointType,
                   Pos        := (0,0,0);
                   Rad        := 0;
                   Mass       := 0;
                   Force      := (0,0,0);
                   OrigPos    := (0,0,0);
                   Influences := array_of(DefInf, 1, 0);
                  ) );
 
now(arrutils('PointType') );
 
now(DefGoal:= new(GoalType,
                  GoalName   := ''; /* users name for goal */
                  GoalSort   := ''; /* the type of goal */
                  Relative   := false; /* is the time relative or abs */
                  Pos        := (0,0,0); /* goal positon */
                  Vel        := (0,0,0); /* goal velocity */
                  LastAcc    := (0,0,0); /* last acceleration */
                  GoalTime   := 0;       /* goal time */
                  StartAct   := 0;
                  StartTight := 0;
                  FinishAct  := 0;
                  Active     := false;
                 ) );
 
now(arrutils('GoalType') );
 
now(DefFullObj:= new(FullObjType,
                     Activity := 0;
                     SelfActiv:= 0;
                     BecomesCentre := false;
                     StartAct := 0; /* when object starts activity */
                     EndAct   := 0; /* when object end activity */
                     FullyAct := 0; /* how long to full activity */
                     Points   := array_of(DefPoint, 0, 0);
                                /* point 0 reserved for centre */
                     Density  := 1; /* density of object */
                     Mass     := 1;
                     Inertia  := 1; /* should be a tensor */
                     InvIner  := 1; /* should also be a tensor */
                     LinDamp  := 1; /* Linear Damping */
                     AngDamp  := 1; /* Angular Damping */
                     LinMom   := (0,0,0); /* Linear Momentum */
                     AngMom   := (0,0,0); /* Angular Momentum */
                     LinVel   := (0,0,0); /* Linear Velocity */
                     AngVel   := (0,0,0); /* Angular Velocity */
                     LinPos   := (0,0,0); /* Linear Position */
                     AngPos   := (0,0,0); /* Angular Position */
                     LastTS   := 1; /* Last Time Step */
                     TotTrans := at(0,0,0);
                     PreTrans := at(0,0,0);
                     TotBirth := at(0,0,0);
                     PreBirth := at(0,0,0);
                     TransSet := false;
                     Goals    := array_of(DefGoal, 1, 0);
                     UsesDancerApprox := false;
                    ) );
 
 
now(Objects:= lookup_of(DefFullObj) ); /* Global Variable */
 
now(ActiveObj:= array_of('', 1, 0) ); /* list of active object names */
 
now(arrutils('sref') );
now(arrutils('vec') );
 
/*---------------------------------------------------------------------*/
/* Dummy functions before proper reading of lifecycl                   */
/*---------------------------------------------------------------------*/
 
{ 'PARENTNAME' function #
  dummy := ?sref;
 
  ''
};
 
{ 'DANCER_APPROX' function #
  dummy := ?sref;
 
  say 'Dummy DANCER_APPROX: It should never have got here !!!!';
 
};
 
/*---------------------------------------------------------------------*/
/* Mathematical Functions                                              */
/*---------------------------------------------------------------------*/
 
{ 'HERMITE' function #
  P1:= ?vec;
  V1:= ?vec;
  TT1:= ?float;
  P2:= ?vec;
  V2:= ?vec;
  TT2:= ?float;
  tt:= ?float;
  /* Calculates the position on a generalised hermite curve at time t */
  /* with boundary conditions P1, V1 at time T1 and P2, V2 at time T2 */
 
  if TT1<TT2 then begin /* New version scales so T1=0 */
   T2  := TT2-TT1;
   DT2 := T2*T2;
   DT3 := T2*T2*T2;
   t   := tt - TT1;
 
   /* calculate coefficients of the cubic */
   a:= 2*(P1-P2)/DT3 + (V1+V2)/DT2;
   b:= -3*T2*(P1-P2)/DT3 - (2*T2*V1+T2*V2)/DT2;
   c:= V1;
   d:= T2*T2*T2*P1/DT3;
 
   Result := array_of( (0,0,0) , 1 , 0); /* array to hold results */
   Result := a*t*t*t + b*t*t + c*t + d › 3*a*t*t + 2*b*t + c;
  end;
  else begin
   Result := array_of( (0,0,0) , 1, 0);
   Result := V1 › P1 + V1 * (TT2 - TT1);
  end;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'QUICKHERMITE' function #
  P1:= ?vec;
  V1:= ?vec;
  P2:= ?vec;
  V2:= ?vec;
  T2:= ?float;
  /* Calculates the acceleration at time t=0.5 on a hermite with */
  /* boundary conditions P1, V1 at time 0 and P2, V2 at time T2 */
 
  DT2 := T2*T2;
  DT3 := T2*T2*T2;
 
  /* calculate top two coefficients of the cubic */
  a:= 2*(P1-P2)/DT3 + (V1+V2)/DT2;
  b:= -3*T2*(P1-P2)/DT3 - (2*T2*V1+T2*V2)/DT2;
 
  Result := 3*a + 2*b;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'CENTREOFATTENFORCE' function #
  P1:= ?vec;
  V1:= ?vec;
  T2:= ?float;
  /* Calculates the accel needed to bring an object at point P1 with */
  /* velocity V1 to the origin still by time T2 in the future, using */
  /* a hermite spline */
 
  DT2 := T2*T2;
  DT3 := T2*T2*T2;
 
  /* calculate coefficients of the cubic */
  a:= 2*P1/DT3 + V1/DT2;
  b:= -3*P1/DT2 - 2*V1/T2;
 
  Result := 3*a + 2*b;
 
  Result
};
 
{ 'CENTREOFATTENFORCE2' function #
  P1:= ?vec;
  V1:= ?vec;
  T2:= ?float;
  /* Calculates the position on a generalised hermite curve at time t */
  /* with boundary conditions position P1, velocity V1and accel W1 */
  /* at time TT1 and P2, V2 and accel 0 at time TT2 */
 
  W1 := LastCentreAccel;
 
  DT2 := T2*T2;
  DT3 := T2*T2*T2;
  DT4 := T2*T2*T2*T2;
  DT5 := T2*T2*T2*T2*T2;
 
  /* calculate coefficients of the cubic */
  a := -3*V1/DT4 - 6*P1/DT5 - W1/DT3;
  b := 8*V1/DT3 + 15*P1/DT4 + 3*W1/DT2;
  c := -10*P1/DT3 - 6*V1/DT2 - 3*W1/T2;
  d := W1;
 
  LastCentreAccel := ((5*a + 6*b)*0.5 + 3*c)*0.5 + d; /* Acc / 2 */
 
  LastCentreAccel * 2
};
 
/*---------------------------------------------------------------------*/
 
{ 'POSVELSPLINE2' function #
  P1  := ?vec;
  V1  := ?vec;
  TT1 := ?float;
  P2  := ?vec;
  V2  := ?vec;
  TT2 := ?float;
  t   := ?float;
  /* Calculates the position & velocity at time T1+t using a cubic */
  /* polynomial spline with boundary conditions: position P1 and */
  /* velocity V1 at time TT1; position P2, velocity V2 at time TT2 */
 
  if TT1<TT2 then begin
   /* Rescale so T1=0, T2=TT2-TT1 */
   T2  := TT2-TT1;
   DT2 := T2*T2;
   DT3 := T2*T2*T2;
 
   /* calculate coefficients of the cubic */
   a:= 2*(P1-P2)/DT3 + (V1+V2)/DT2;
   b:= -3*T2*(P1-P2)/DT3 - (2*T2*V1+T2*V2)/DT2;
   c:= V1;
   d:= T2*T2*T2*P1/DT3;
 
   Pos := ((a*t + b)*t + c)*t + d;
   Vel := (3*a*t + 2*b)*t + c;
   Acc := (0,0,0);
 
   Result := array_of( (0,0,0) , 1 , 0); /* array to hold results */
   Result := Result › Pos › Vel › Acc;
 
   if DrawHermite then begin
    HermiteCSG := sphere(0.2) at(Pos) colour(2)
                  union sphere(0.2) at(P1) colour(1)
                  union sphere(0.2) at(P2) colour(2);
    I := 0;
    do(I, 0, T2, 1,
     HermiteCSG:= HermiteCSG union
                  sphere(0.1) at( ((a*I+b)*I+c)*I+d );
     );
 
    DanceStepCSG := DanceStepCSG union HermiteCSG;
   end;
 
  end;
  else begin
   Result := array_of( (0,0,0), 1, 0);
   Result := Result › P1+t*V1 › V1 › (0,0,0);
   /* Default values of extrapolated position and current velocity */
  end;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'POSVELSPLINE3' function #
  P1  := ?vec;
  V1  := ?vec;
  TT1 := ?float;
  P2  := ?vec;
  V2  := ?vec;
  TT2 := ?float;
  t   := ?float;
  /* Calculates the position & velocity at time T1+t using a 4th order */
  /* polynomial spline with boundary conditions: position P1 and */
  /* velocity V1 at time TT1; position P2, velocity V2 and */
  /* acceleration (0,0,0) at time T2 */
 
  if TT1<TT2 then begin
   /* Rescale so T1=0, T2=TT2-TT1 */
   T2  := TT2-TT1;
   DT2 := T2*T2;
   DT3 := T2*T2*T2;
   DT4 := T2*T2*T2*T2;
 
   /* calculate coefficients of the cubic */
   a := (-V1-2*V2)/DT3 - 3*(P1-P2)/DT4;
   b := (3*V1+5*V2)/DT2 + 8*(P1-P2)/DT3;
   c := (-3*V1-3*V2)/T2 - 6*(P1-P2)/DT2;
   d := V1;
   e := P1;
 
   Pos := (((a*t + b)*t + c)*t + d)*t + e;
   Vel := ((4*a*t + 3*b)*t + 2*c)*t + d;
 
   Result := array_of( (0,0,0) , 1 , 0); /* array to hold results */
   Result := › Pos › Vel;
 
   if DrawHermite then begin
    HermiteCSG := sphere(0.2) at(Pos) colour(2)
                  union sphere(0.2) at(P1) colour(1)
                  union sphere(0.2) at(P2) colour(2);
    I := 0;
    do(I, 0, T2, 1,
     HermiteCSG:= HermiteCSG union
                  sphere(0.1) at( (((a*I+b)*I+c)*I+d)*I+e );
     );
 
    DanceStepCSG := DanceStepCSG union HermiteCSG;
   end;
 
  end;
  else begin
   Result := array_of((0,0,0), 1, 0);
   Result := › P1+t*V1 › V1;
   /* Default values of extrapolated position and current velocity */
  end;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'POSVELSPLINE4' function #
  P1  := ?vec;
  V1  := ?vec;
  TT1 := ?float;
  P2  := ?vec;
  TT2 := ?float;
  V3  := ?vec;
  TT3 := ?float;
  t:= ?float;
  /* Calculates the position & velocity at time T1+t using a 3rd order */
  /* polynomial spline with boundary conditions: position P1 and */
  /* velocity V1 at time TT1, position P2 at time TT2, velocity V3 at */
  /* time TT3 */
 
  if TT1<TT2 then begin
   /* rescale so T1=0, T2=TT2-TT1, T3=TT3-TT1 */
   T2 := TT2-TT1;
   T3 := TT3-TT1;
 
   /* calculate coefficients of the cubic */
   a := (V1*(2*T3-T2)+V3*T2)/(T2*T3*(3*T3-2*T2))
        + 2*(P1-P2)/(T2*T2*(3*T3-2*T2));
   b := (V1*(T2*T2-3*T3*T3)-V3*T2*T2)/(T2*T3*(3*T3-2*T2))
        + 3*(P2-P1)*T3/(T2*T2*(3*T3-2*T2));
   c := V1;
   d := P1;
 
   Pos := ((a*t + b)*t + c)*t + d;
   Vel := (3*a*t + 2*b)*t + c;
   Acc := 6*a*t + 2*b;
 
   Result := array_of( (0,0,0) , 1 , 0); /* array to hold results */
   Result := Result › Pos › Vel;
 
   if DrawHermite then begin
    HermiteCSG := sphere(0.2) at(Pos) colour(2)
                  union sphere(0.2) at(P1) colour(1)
                  union sphere(0.2) at(P2) colour(2);
    I := 0;
    do(I, 0, T2, 1,
     HermiteCSG:= HermiteCSG union
                  sphere(0.1) at( ((a*I+b)*I+c)*I+d );
     );
 
    DanceStepCSG := DanceStepCSG union HermiteCSG;
   end;
 
  end;
  else begin
   Result := array_of( (0,0,0), 1, 0);
   Result := Result › P1+t*V1 › V1;
   /* Default values of extrapolated position and current velocity */
  end;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'POSPOSSPLINE' function #
  P1  := ?vec;
  V1  := ?vec;
  TT1 := ?float;
  P2  := ?vec;
  TT2 := ?float;
  P3  := ?vec;
  TT3 := ?float;
  t:= ?float;
  /* Calculates the position & velocity at time T1+t using a 3rd order */
  /* polynomial spline with boundary conditions: position P1 and */
  /* velocity V1 at time TT1, position P2 at time TT2, position P3 at */
  /* time TT3 */
 
  if TT1<TT2 then begin
   /* rescale so T1=0, T2=TT2-TT1, T3=TT3-TT1 */
   T2 := TT2-TT1;
   T3 := TT3-TT1;
 
   /* calculate coefficients of the cubic */
   a := P1*(T2+T3)/(T2*T2*T3*T3) + P2/(T2*T2*(T2-T3))
        + P3/(T3*T3*(T3-T2)) + V1/(T2*T3);
   b := -P1*(T2*T2+T2*T3+T3*T3)/(T2*T2*T3*T3) + P2*T3/(T2*T2*(T3-T2))
        + P3*T2/(T3*T3*(T2-T3)) - V1*(T2+T3)/(T2*T3);
   c := V1;
   d := P1;
 
   Pos := ((a*t + b)*t + c)*t + d;
   Vel := (3*a*t + 2*b)*t + c;
   Acc := 6*a*t + 2*b;
 
   Result := array_of( (0,0,0) , 1 , 0); /* array to hold results */
   Result := Result › Pos › Vel;
 
   if DrawHermite then begin
    HermiteCSG := sphere(0.2) at(Pos) colour(2)
                  union sphere(0.2) at(P1) colour(1)
                  union sphere(0.2) at(P2) colour(2);
    I := 0;
    do(I, 0, T2, 1,
     HermiteCSG:= HermiteCSG union
                  sphere(0.1) at( ((a*I+b)*I+c)*I+d );
     );
 
    DanceStepCSG := DanceStepCSG union HermiteCSG;
   end;
 
  end;
  else begin
   Result := array_of( (0,0,0), 1, 0);
   Result := Result › P1+t*V1 › V1;
   /* Default values of extrapolated position and current velocity */
  end;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'POSVELSPLINE' function #
  P1:= ?vec;
  V1:= ?vec;
  W1:= ?vec;
  TT1:= ?float;
  P2:= ?vec;
  V2:= ?vec;
  TT2:= ?float;
  t:= ?float;
  /* Calculates the position on a generalised hermite curve at time t */
  /* with boundary conditions position P1, velocity V1 and accel W1 */
  /* at time TT1 and P2, V2 and accel 0 at time TT2 */
 
  if TT1<TT2 then begin
   /* Rescale so T1=0, T2=TT2-TT1 */
   T2  := TT2-TT1;
   DT2 := T2*T2;
   DT3 := T2*T2*T2;
   DT4 := T2*T2*T2*T2;
   DT5 := T2*T2*T2*T2*T2;
 
   /* calculate coefficients of the cubic */
   a := (-3*V1-3*V2)/DT4 + 6*(P2-P1)/DT5 - W1/DT3;
   b := (8*V1+7*V2)/DT3 - 15*(P2-P1)/DT4 + 3*W1/DT2;
   c := 10*(P2-P1)/DT3 - (6*V1+4*V2)/DT2 - 3*W1/T2;
   d := W1;
   e := V1;
   f := P1;
 
   say 'a: ' a;
   say 'b: ' b;
   say 'c: ' c;
 
   Pos := ((((a*t + b)*t + c)*t + d)*t + e)*t + f;
   Vel := (((5*a*t + 4*b)*t + 3*c)*t + 2*d)*t + e;
   Acc := ((10*a*t + 6*b)*t + 3*c)*t + d; /* Acc / 2 */
 
   Result := array_of( (0,0,0) , 1 , 0); /* array to hold results */
   Result := Result › Pos › Vel › Acc;
 
   if DrawHermite then begin
    HermiteCSG := sphere(0.2) at(Pos) colour(2)
                  union sphere(0.2) at(P1) colour(1)
                  union sphere(0.2) at(P2) colour(2);
    I := 0;
    do(I, 0, T2, 1,
     HermiteCSG:= HermiteCSG union
                  sphere(0.1) at( ((((a*I+b)*I+c)*I+d)*I+e)*I+f );
     );
 
    DanceStepCSG := DanceStepCSG union HermiteCSG;
   end;
 
  end;
  else begin
   Result := array_of( (0,0,0), 1, 0);
   Result := Result › P1+t*V1 › V1 › (0,0,0);
   /* Default values of extrapolated position and current velocity */
  end;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'POSSPLINE' function #
  P1  := ?vec;
  V1  := ?vec;
  W1  := ?vec;
  TT1 := ?float;
  P2  := ?vec;
  TT2 := ?float;
  t   := ?float;
  /* calculates the position, velocity and accelerations on a quartic */
  /* spline, boundary conditions of final position */
 
  if TT1<TT2 then begin
   /* Rescale so T1=0, T2=TT2-TT1 */
   T2  := TT2-TT1;
   DT2 := T2*T2;
   DT3 := T2*T2*T2;
   DT4 := T2*T2*T2*T2;
 
   a:= (P1-P2)/DT4 + V1/DT3 + 2*W1/(3*DT2);
   b:= 2*(P2-P1)/DT3 - 2*V1/DT2 - 5*W1/(3*T2);
 
   NewP := (((a*t + b)*t + W1)*t + V1)*t + P1;
   NewV := ((4*a*t + 3*b)*t + 2*W1)*t + V1;
   NewW := (6*a*t + 3*b)*t + W1;
 
   Result := NewP › NewV › NewW;
  end;
  else begin
   Result := array_of( (0,0,0), 1, 0);
   Result := Result › P1+t*V1 › V1 › (0,0,0);
   /* Default values of extrapolated position and current velocity */
  end;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'VELSPLINE' function #
  P1  := ?vec;
  V1  := ?vec;
  W1  := ?vec;
  TT1 := ?float;
  V2  := ?vec;
  TT2 := ?float;
  t   := ?float;
  /* calculates the position, velocity and accelerations on a quartic */
  /* spline, boundary conditions of final position */
 
  if TT1<TT2 then begin
   /* Rescale so T1=0, T2=TT2-TT1 */
   T2  := TT2-TT1;
   DT2 := T2*T2;
   DT3 := T2*T2*T2;
 
   a:= (V1-V2)/(2*DT3) + W1/(2*DT2);
   b:= (V2-V1)/DT2 - 4*W1/(3*T2);
 
   NewP := (((a*t + b)*t + W1)*t + V1)*t + P1;
   NewV := ((4*a*t + 3*b)*t + 2*W1)*t + V1;
   NewW := (6*a*t + 3*b)*t + W1;
 
   Result := NewP › NewV › NewW;
  end;
  else begin
   Result := array_of( (0,0,0), 1, 0);
   Result := Result › P1+t*V1 › V1 › (0,0,0);
   /* Default values of extrapolated position and current velocity */
  end;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'COSTVUP' function #
  From := ?float;
  To   := ?float;
  X    := ?float;
  /* calculates upward cosine time variant function, range 0 to 1 */
 
  if X<From then Result:= 0;
   else {
    if X>To then Result:= 1;
    else Result:= 0.5 - 0.5*cos( (X-From)*Pi/(To-From) );
    };
  Result := Result * Result;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'COSTVDOWN' function #
  From := ?float;
  To   := ?float;
  X    := ?float;
  /* calculates downward cosine time variant function, range 0 to 1 */
 
  if X<From then Result:= 1;
   else {
    if X>To then Result:= 0;
    else Result:= 0.5 + 0.5*cos( (X-From)*Pi/(To-From) );
    };
  Result := Result*Result;
 
  Result
};
 
/*---------------------------------------------------------------------*/
 
{ 'CALCGOALWEIGHT' function #
  CurGoal := ?GoalType;
  CurTime := ?float;
  /* calculates the weighting attached to a goal */
 
  if CurTime<=CurGoal.GoalTime then
   Result := COSTVDOWN(CurGoal.StartTight, CurGoal.GoalTime, CurTime);
  else
   Result := COSTVUP(CurGoal.GoalTime, CurGoal.FinishAct, CurTime);
 
  Result
};
 
/*---------------------------------------------------------------------*/
/* The basic definitions of forces                                     */
/*---------------------------------------------------------------------*/
 
{ 'CONSTRAINTFORCE' function #
  Pos := ?vec; /* Position of Object */
  S   := ?float;
  /* Global Constraining force */
  /* Set up as influence 'CONSTRAIN' */
 
  /* Constraint Force Power of 3 */
  /* Constraint Force Coefficient of 0.005 * S */
 
  d:= length(Pos);
  if (d<0.000001) then F:= (0,0,0);
                  else F:= -0.0015 * S * (d*d*d) * Pos /d;
 
  if DanceTrace>=5 then say 'Strength ' F;
 
  F
};
 
/*---------------------------------------------------------------------*/
 
{'DISTANCEFORCE' function #
  Pos1   := ?vec; /* Position of Main Object */
  Vel1   := ?vec; /* Velocity of Main Object */
  Pos2   := ?vec; /* Position of Attracting Object */
  Vel2   := ?vec; /* Velocity of Attracting Object */
  Equil  := ?float; /* Equilibrium Force Distance */
  Strgth := ?float; /* Strength of force */
  /* Force that tries to maintain fixed distance between points */
  /* Set up as influence 'DISTANCE' */
 
  DPos := Pos1 - Pos2;
  DVel := Vel1 - Vel2;
  l := length(DPos);
  if (l<0.000001)|(Strgth=0) then F := (0,0,0);
   else begin
    Dir  := DPos / l;
    RVel := dot(DVel, Dir) * Dir;
    RPos := Equil * Dir;
    F    := QuickHermite(DPos, RVel, RPos, (0,0,0), 30/Strgth);
   end;
 
  if DanceTrace>=5 then say 'Strength ' F;
 
  F
};
 
/*---------------------------------------------------------------------*/
 
{'COLLISIONFORCE' function #
  Pos1 := ?vec; /* Position of Main Object */
  Pos2 := ?vec; /* Position of Repelling Object */
  Rad1 := ?float; /* Nominal Radius of Main Object */
  Rad2 := ?float; /* Nominal Radius of Repelling Object */
  /* Force that keeps objects apart using nominal radii */
 
  if (Rad1=0)|(Rad2=0) then F := (0,0,0);
   else begin
    Sep:= Rad1 + Rad2;
    /* Repulsion Force Power of -4 */
    K:= (Sep*Sep*Sep*Sep*Sep); /* Repulsion Force Coefficient */
 
    d:= length(Pos1 - Pos2);
    if (d<Sep)&(DanceTrace>=1) then say 'COLLISION !!!!' Rad1 Rad2;
 
    if (d<Sep) then begin
     if d<0.000001 then F:= (0,0,0);
          else F:= 0.1*(3 - 2 * d*d / (Sep*Sep) ) * (Pos1 - Pos2) /d;
     end;
    else F:= 0.1*(K / (d*d*d*d) ) * (Pos1 - Pos2) / d;
   end;
 
  if DanceTrace>=6 then say 'Strength ' F;
 
  F
};
 
/*---------------------------------------------------------------------*/
 
{'SOLENOIDFORCE' function #
  Pos := ?vec; /* Position of Object */
  Str := ?float; /* Strength of Force */
  /* Stirring force */
  /* 'Solenoid' radius R, positioned with axis along y axis */
 
  R:= 2.5;
 
  VY  := (0, Pos.x2, 0);
  VXZ := Pos - VY;
 
  Y   := Pos.x2;
  LXZ := length(VXZ);
 
  if LXZ=0 then F:= (0, -Str, 0);
   else begin
    K := ( (R-LXZ)*(R-LXZ) + Y*Y ) / ( (R+LXZ)*(R+LXZ) + Y*Y );
 
    StY := ( R*(1+K)/(1-K) - LXZ );
    F   := ( -Y*Pos.x1/LXZ, -STY, -Y*Pos.x3/LXZ );
    if length(F)<0.000001 then F := 0.01*(0, -Str, 0);
                          else F := 0.01*Str * normal(F);
   end;
 
  if DanceTrace>=5 then say 'Strength ' F;
 
  F
};
 
/*---------------------------------------------------------------------*/
 
{'CIRCLEFORCE' function #
  Pos := ?vec; /* Position of Object */
  Str := ?float; /* Strength of Force */
  /* Circular Stirring force */
 
  A := (Pos.x3, 0, -Pos.x1);
  if A^=(0,0,0) then F:= 0.004*Str*normal(A);
                else F:= (0,0,0);
 
  if DanceTrace>=5 then say 'Strength ' F;
 
  F
};
 
/*---------------------------------------------------------------------*/
 
{'ORBITFORCE' function #
  Pos := ?vec; /* Position of Object */
  Dir := ?vec; /* Direction of motion for Object */
  Str := ?float; /* Strength of Force */
  /* Force that makes an object tend to orbit around centre */
 
  A := (Pos # Dir) # Pos;
  if A^=(0,0,0) then F := 0.004*Str*normal(A);
                else F := (0,0,0);
 
  if DanceTrace>=5 then say 'Strength ' F;
 
  F
};
 
/*---------------------------------------------------------------------*/
 
{'SWIMFORCE' function #
  Pos1 := ?vec; /* Position of Swiming Object */
  Pos2 := ?vec; /* Position to Swim from */
  Str := ?float; /* Strength of Force */
  /* Force that makes an object tend to swim away from a given point */
 
  if Pos1^=Pos2 then F := 0.004*Str*normal(Pos1-Pos2);
                else F := (0,0,0);
 
  if DanceTrace>=5 then say 'Strength ' F;
 
  F
};
 
/*---------------------------------------------------------------------*/
/* Functions for processing forces                                     */
/*---------------------------------------------------------------------*/
 
{ 'GLOBALFORCE' function #
   CurPoint := ?PointType;
   CurOName := ?sref;
   CurInf   := ?InfType;
 
  F := (0,0,0);
 
  /* constraining box influence */
  /* Parm1 : How strongly affected by constraint force */
  if (CurInf.InfSort='CONSTRAIN') then
   F:= ConstraintForce(CurPoint.Pos, CurInf.Parm1) * CurPoint.Mass;
 
  /* solenoidal stiring influence */
  /* Parm1 : How strongly affected by solenoidal stiring force */
  if (CurInf.InfSort='SOLENOID') then
   F:= SolenoidForce(CurPoint.Pos, CurInf.Parm1) * CurPoint.Mass;
 
  /* circular stiring influence */
  /* Parm1 : How strongly affected by circular stiring force */
  if (CurInf.InfSort='CIRCLE') then
   F:= CircleForce(CurPoint.Pos, CurInf.Parm1) * CurPoint.Mass;
 
  /* orbit influence */
  /* Parm1 : How strongly affected by orbit force */
  if (CurInf.InfSort='ORBIT') then
   F:= OrbitForce(CurPoint.Pos, (Objects@CurOName).LinVel, CurInf.Parm1)
       * CurPoint.Mass;
 
  /* Global Distance influence */
  /* Parm1 : Equilibrium distance */
  /* Parm2 : How strongly affected by SetDistance force */
  /* Vec1  : Centre of attraction */
  if (CurInf.InfSort='DISTANCE') then
   F:= DistanceForce(CurPoint.Pos, (Objects@CurOName).LinVel,
                     CurInf.Vec1, (0,0,0), CurInf.Parm1, CurInf.Parm2)
                     * CurPoint.Mass / TimeFactor;
 
  /* Swimming influence */
  /* Parm1 : How strongly affected by Swim force */
  if (CurInf.InfSort='SWIM') then
   F:= SwimForce(CurPoint.Pos, (Objects@CurOName).LinPos, CurInf.Parm1)
                     * CurPoint.Mass;
 
  F
};
 
/*---------------------------------------------------------------------*/
 
{ 'ALLPOINTSFORCE' function #
   CurPoint := ?PointType;
   CurOName := ?sref;
   CurInf   := ?InfType;
 
   F      := (0,0,0);
   Obj2   := 0;
   Point2 := 0;
 
   /* loop through second objects */
   do(Obj2, 1, highbound(ActiveObj),
 
   /* check object not same as current one */
   if (CurOName^=ActiveObj@Obj2) then
    begin
     SecObj:= Objects@(ActiveObj@Obj2);
 
     /* loop through points on second object */
     do(Point2, 0, highbound( SecObj.Points ),
 
      /* calculate force between points */
      SecPoint:= (SecObj.Points)@Point2;
 
      /* Collision force type */
      /* Parm1 : How strongly affected by collision forces */
      if (CurInf.InfSort='COLLISION')&(SecPoint.Rad^=0) then
       F := F + CollisionForce(CurPoint.Pos, SecPoint.Pos,
                               CurPoint.Rad, SecPoint.Rad)
              * CurPoint.Mass * SecPoint.Mass
              * CurInf.Parm1 * SecObj.Activity;
 
      ); /* end Point2 loop */
    end;
   ); /* end Obj2 loop */
  F
};
 
/*---------------------------------------------------------------------*/
 
{ 'ONEPOINTFORCE' function #
   CurPoint := ?PointType;
   CurOName := ?sref;
   SecPoint := ?PointType;
   CurInf   := ?InfType;
 
  /* Orbit influence */
  /* Parm1 : How strongly affected by orbit force */
  if (CurInf.InfSort='ORBIT') then
   F:= OrbitForce(CurPoint.Pos - SecPoint.Pos,
       (Objects@CurOName).LinVel - (Objects@(CurInf.SecObj)).LinVel,
       CurInf.Parm1)
       * CurPoint.Mass;
 
  /* Distance influence */
  /* Parm1 : Equilibrium distance */
  /* Parm2 : How strongly affected by SetDistance force */
  if (CurInf.InfSort='DISTANCE') then
   F:= DistanceForce(CurPoint.Pos, (Objects@CurOName).LinVel,
                     SecPoint.Pos, (Objects@(CurInf.SecObj)).LinVel,
                     CurInf.Parm1, CurInf.Parm2)
                     * CurPoint.Mass / TimeFactor;
 
  F
};
 
/*---------------------------------------------------------------------*/
 
{ 'CALCFORCES' function #
  dummy := ?stmt;
  /* calculates the forces acting on all the point that make up object */
 
  Obj1   := 0; /* declare control variables for loops */
  Point1 := 0;
  ChNum  := 0;
  InfNum := 0;
 
  /* loop through all the active objects */
  do(Obj1, 1, highbound(ActiveObj),
   CurObjName:= ActiveObj@Obj1;
 
   CurObj:= Objects@CurObjName;
 
   if DanceTrace>=3 then say 'Forces on Object ' CurObjName;
   if DanceTrace>=4 then say 'Object Mass :' CurObj.Mass;
   if DanceTrace>=5 then begin
    say 'Object Activity :' CurObj.Activity;
    say 'Object SelfActivity :' CurObj.SelfActiv;
   end;
 
   /* loop thorugh all the points object made up of */
   do(Point1, 0, highbound(CurObj.Points),
    CurPoint:= (CurObj.Points)@Point1;
    CurPoint.Force:= (0,0,0);
 
    /* calculate direct influence forces on point */
    do(InfNum, 1, highbound(CurPoint.Influences),
     CurInf:= (CurPoint.Influences)@InfNum;
 
     if DanceTrace>=4 then
       say 'Point ' Point1'  Influence ' CurInf.InfSort CurInf.Scope;
 
     if (CurInf.Scope='GLOBAL')&(CurObjName^=CentreOfAttention) then
       CurPoint.Force := CurPoint.Force
         + GlobalForce(CurPoint, CurObjName, CurInf);
 
     if CurInf.Scope='ALLPOINTS' then
       CurPoint.Force := CurPoint.Force
         + AllPointsForce(CurPoint, CurObjName, CurInf);
 
     if CurInf.Scope='ONEPOINT' then
       begin
         SecPoint:=((Objects@(CurInf.SecObj)).Points)@(CurInf.SecPoint);
         CurPoint.Force := CurPoint.Force
           + OnePointForce(CurPoint, CurObjName, SecPoint, CurInf);
       end;
 
     ); /* end InfNum loop */
 
    /* scale by object activity */
    CurPoint.Force := CurPoint.Force * CurObj.SelfActiv;
 
    (CurObj.Points)@Point1:= CurPoint; /* place point back into array */
    ); /* end Point1 loop */
 
   Objects@CurObjName:= CurObj; /* place object back into array */
   ); /* end Obj1 loop */
 
};
 
/*---------------------------------------------------------------------*/
 
{ 'APPLYFORCES' function #
  TimeStep := ?float; /* discrete time step for iteration */
  CurTime  := ?float; /* the current time */
  /* calculates total force and moment on each main object */
  /* uses this mass and inertia to calculate transform */
 
  ONum := 0; /* control variables for loops */
  PNum := 0;
  GNum := 0;
 
  do(ONum, 1, highbound(ActiveObj),
   OName  := ActiveObj@ONum;
   CurObj := Objects@OName;
   LinPos := CurObj.LinPos;
   LinVel := CurObj.LinVel;
   AngPos := CurObj.AngPos;
   AngVel := CurObj.InvIner * CurObj.AngMom;
 
   if DanceTrace>=3 then say 'Applying to Object ' OName;
   if DanceTrace>=4 then begin
    say 'Old LinPos :' LinPos;
    say 'Old LinVel :' LinVel;
    say 'Old AngPos :' AngPos;
    say 'Old AngVel :' AngVel;
   end;
 
   LinPosWgt := 1;       /* The current weight for each of the */
   LinVelWgt := 1;       /* various quantities */
   AngPosWgt := 1;
   AngVelWgt := 1;
 
   /* calculate external force & moment due to forces on points */
   TotalF := (0,0,0);
   TotalM := (0,0,0);
 
   if OName=CentreOfAttention then begin
    if DanceTrace>=4 then say 'Calculating Centre Of Attention Force';
    TotalF := DistanceForce(LinPos,LinVel,(0,0,0),(0,0,0),0,0.4)
              * CurObj.SelfActiv * CurObj.Mass / TimeFactor;
   end;
 
   do(PNum, 0, highbound(CurObj.Points),
    CurPnt := (CurObj.Points)@PNum;
    TotalF := TotalF + CurPnt.Force;
    TotalM := TotalM + ( (CurPnt.Pos - LinPos) # CurPnt.Force );
    ); /* end PNum loop */
 
   TotalF   := TotalF * TimeFactor;
   TotalM   := TotalM * TimeFactor;
   if DanceTrace>=4 then say 'Total Force ' TotalF;
   if DanceTrace>=4 then say 'Total Moment ' TotalM;
 
   TimeMult := TimeStep * TimeFactor;
 
   /* calculate desired position change etc due to forces */
   TempLinVel := LinVel + TotalF / CurObj.Mass -
                  LinVel*(1-CurObj.LinDamp**TimeMult)*CurObj.Activity;
   TempAngVel := AngVel + TotalM * CurObj.InvIner -
                 AngVel*(1-CurObj.AngDamp**TimeMult)*CurObj.Activity;
 
   DLinVel := TempLinVel - LinVel;
   DLinPos := TempLinVel * TimeStep;
   DAngVel := TempAngVel - AngVel;
   DAngPos := TempAngVel * TimeStep;
      /****
   /* calculate change in desired position etc.. due to goals */
   do(GNum, 1, highbound(CurObj.Goals),
    CurGoal   := (CurObj.Goals)@GNum;
 
   if (CurGoal.Active)
      &(CurTime>=CurGoal.StartAct)&(CurTime<=CurGoal.FinishAct)
    then begin
     CurWeight := CalcGoalWeight(CurGoal, CurTime + TimeStep);
 
     if (CurGoal.GoalSort='LINPOSVEL')
       |(CurGoal.GoalSort='LINPOS')
       |(CurGoal.GoalSort='LINVEL')
      then begin
 
       if CurWeight<LinPosWgt then begin
        DLinPos := DLinPos * CurWeight / LinPosWgt;
        LinPosWgt := CurWeight;
        LinPosFactor := 1;
       end;
       else begin
        if CurWeight=0 then LinPosFactor := 1;
        else LinPosFactor := LinPosWgt / CurWeight;
       end; /* CurWeight<LinPosWgt */
 
       if CurWeight<LinVelWgt then begin
        DLinVel := DLinVel * CurWeight / LinVelWgt;
        LinVelWgt := CurWeight;
        LinVelFactor := 1;
       end;
       else begin
        if CurWeight=0 then LinVelFactor := 1;
        else LinVelFactor := LinVelWgt / CurWeight;
       end; /* CurWeight<LinVelWgt */
 
       if CurGoal.GoalSort='LINPOSVEL' then
        GoalValues :=PosVelSpline3(LinPos,LinVel,CurGoal.LastAcc,CurTime,
                      CurGoal.Pos,CurGoal.Vel,CurGoal.GoalTime,TimeStep);
 
       if CurGoal.GoalSort='LINPOS' then
        GoalValues := PosSpline(LinPos,LinVel,CurGoal.LastAcc,CurTime,
                      CurGoal.Pos,CurGoal.GoalTime,TimeStep);
 
       if CurGoal.GoalSort='LINVEL' then
        GoalValues := VelSpline(LinPos,LinVel,CurGoal.LastAcc,CurTime,
                      CurGoal.Vel,CurGoal.GoalTime,TimeStep);
 
       DLinPos := DLinPos + LinPosFactor * (GoalValues@1 - LinPos);
       DLinVel := DLinVel + LinVelFactor * (GoalValues@2 - LinVel);
 
       CurGoal.LastAcc := GoalValues@3; /* the new acceleration value */
      end; /* GoalSort='LINEAR' */
 
    /* This is where other goals will go */
 
      (CurObj.Goals)@GNum := CurGoal; /* put info back into goal */
     end; /* CurTime>StartAct */
 
    );  *****/
 
   /* Calculate changes */
   LinPos := LinPos + DLinPos;
   LinVel := LinVel + DLinVel;
   AngPos := Angpos + DAngPos;
   AngVel := AngVel + DAngVel;
 
   if DanceTrace>=4 then begin
    say 'New LinPos :' LinPos;
    say 'New LinVel :' LinVel;
    say 'New AngPos :' AngPos;
    say 'New AngVel :' AngVel;
   end;
 
   CurObj.LinMom := LinVel * CurObj.Mass;
   CurObj.AngMom := AngVel * CurObj.Inertia;
   CurObj.LinPos := LinPos;
   CurObj.AngPos := AngPos;
   CurObj.LinVel := LinVel;
   CurObj.AngVel := AngVel;
 
   /* calculate transform */
   Centre := ((CurObj.Points)@0).OrigPos;
   MagAngPos:= length(AngPos);
   if MagAngPos>0.000001 then begin
     NewTrans :=  at( -Centre)
                  rot( MagAngPos * 180/Pi, AngPos )
                  at( LinPos ) ;
     end;
    else NewTrans := at(LinPos - Centre);
 
   CurObj.TotTrans := NewTrans;
 
   /* apply transform to the points */
   do(PNum, 0, highbound(CurObj.Points),
    CurPoint := (CurObj.Points)@PNum;
    CurPoint.Pos := CurPoint.OrigPos CurObj.TotTrans;
    (CurObj.Points)@PNum := CurPoint;
    ); /* end PNum loop */
 
   CurObj.LastTS := TimeStep;
   Objects@OName := CurObj; /* place object back into array */
   ); /* end ONum loop */
};
 
/*---------------------------------------------------------------------*/
/* Functions for initial setting up of forces on objects               */
/*---------------------------------------------------------------------*/
 
{ 'NEWINFLUENCE' function #
  O1Name  := ?sref;
  P1Num   := ?float;
  InfSort := ?sref;
  Scope   := ?sref;
  O2Name  := ?sref;
  P2Num   := ?float;
  /* checks Object O1Name at point P1Num to see if there is */
  /* already a corresponding correct sort of influence. If there is */
  /* it returns a pointer to this influence, otherwise a new influence */
  /* is added and a pointer to this returned */
 
  CurObj   := Objects@O1Name;
  CurPoint := (CurObj.Points)@P1Num;
 
  InfNum   := 0;
  Match    := false;
  while( (^Match) & (InfNum<highbound(CurPoint.Influences)),
   InfNum := InfNum + 1;
   CurInf := (CurPoint.Influences)@InfNum;
   if (Scope^='ONEPOINT') & (InfSort=CurInf.InfSort)
                          & (Scope=CurInf.Scope) then Match := true;
 
   if (Scope='ONEPOINT') & (InfSort=CurInf.InfSort)
                         & (O2Name=CurInf.SecObj)
                         & (P2Num=CurInf.SecPoint) then Match := true;
   );
 
  if ^Match then
   begin
    CurInf := DefInf;
    CurInf.InfSort := InfSort;
    CurInf.Scope := Scope;
    CurInf.SecObj := O2Name;
    CurInf.SecPoint := P2Num;
    CurPoint.Influences := CurPoint.Influences › CurInf;
    InfNum := highbound(CurPoint.Influences);
    (CurObj.Points)@P1Num := CurPoint;
    Objects@O1Name := CurObj;
   end;
 
  InfNum
};
 
now(add_defaults('NEWINFLUENCE','sref,float,sref,sref,sref="",float=0'));
 
/*---------------------------------------------------------------------*/
 
{ 'SETCOLLISION' function #
  OName := ?sref;
  PNum  := ?float;
  Str   := ?float;
  /* Sets the strength with which point PNum on object OName is */
  /* affected by collision forces */
 
  InfNum := NewInfluence(OName,PNum,'COLLISION','ALLPOINTS');
 
  CurObj    := Objects@OName;
  CurPoint  := (CurObj.Points)@PNum;
  CurInf    := (CurPoint.Influences)@InfNum;
 
  CurInf.Parm1   := Str;
 
  (CurPoint.Influences)@InfNum := CurInf;
  (CurObj.Points)@PNum         := CurPoint;
  Objects@OName                := CurObj;
 
};
 
add_defaults('SETCOLLISION','sref, float, float=1');
 
{ 'SETCOLLISION' function #
  OName := ?sref;
  Str   := ?float;
  /* by default sets collision detection for all points other than 0 */
 
  PNum := 0;
  do(PNum, 1, highbound( (Objects@OName).Points ),
   SetCollision(OName, PNum, Str);
   );
 
};
 
add_defaults('SETCOLLISION','sref, float=1');
 
/*---------------------------------------------------------------------*/
 
{ 'SETMASS' function #
  OName := ?sref;
  PNum  := ?float;
  Mass  := ?float;
  /* Sets the mass of point PNum on object OName to Rad */
 
  CurObj   := Objects@OName;
  CurPoint := (CurObj.Points)@PNum;
 
  CurPoint.Mass := Mass;
 
  (CurObj.Points)@PNum := CurPoint;
  Objects@OName        := CurObj;
 
};
 
add_defaults('SETMASS','sref, float=0, float');
 
/*---------------------------------------------------------------------*/
 
{ 'SETRADIUS' function #
  OName := ?sref;
  PNum  := ?float;
  Rad   := ?float;
  /* Sets the mass of point PNum on object OName to Rad */
 
  CurObj   := Objects@OName;
  CurPoint := (CurObj.Points)@PNum;
 
  CurPoint.Rad := Rad;
 
  (CurObj.Points)@PNum := CurPoint;
  Objects@OName        := CurObj;
 
};
 
add_defaults('SETMASS','sref, float=0, float');
 
/*---------------------------------------------------------------------*/
 
{ 'SETDISTANCE' function #
  O1Name := ?sref;
  P1Num  := ?float;
  O2Name := ?sref;
  P2Num  := ?float;
  Dist   := ?float;
  Strngth:= ?float;
  /* Sets the distance that object O1Name point P1Num likes tries to */
  /* maintain from object O2Name point P2Num to Dist, with strength  */
  /* Strngth */
 
  InfNum :=NewInfluence(O1Name,P1Num,'DISTANCE','ONEPOINT',O2Name,P2Num);
 
  CurObj   := Objects@O1Name;
  CurPoint := (CurObj.Points)@P1Num;
  CurInf   := (CurPoint.Influences)@InfNum;
 
  CurInf.Parm1    := Dist;
  CurInf.Parm2    := Strngth;
 
  (CurPoint.Influences)@InfNum := CurInf;
  (CurObj.Points)@P1Num        := CurPoint;
  Objects@O1Name               := CurObj;
 
};
 
add_defaults('SETDISTANCE','sref,float=0,sref,float=0,float,float=1');
 
/*---------------------------------------------------------------------*/
 
{ 'SETDISTANCE' function #
  O1Name := ?sref;
  O2Name := ?sref;
  Dist   := ?float;
  Strngth:= ?float;
  /* Sets the distance that object O1Name likes tries to */
  /* maintain from object O2Name to Dist, with strength  */
  /* Strngth */
 
  SetDistance(O1Name,0,O2Name,0,Dist,Strngth);
 
};
 
add_defaults('SETDISTANCE','sref,sref,float,float=1');
 
/*---------------------------------------------------------------------*/
 
{ 'SETDISTANCE' function #
  O1Name := ?sref;
  P1Num  := ?float;
  Dist   := ?float;
  Vec    := ?vec;
  Strngth:= ?float;
  /* Sets the distance that object O1Name point P1Num likes tries to */
  /* maintain from point Vec to Dist, with strength Strngth */
 
  InfNum := NewInfluence(O1Name,P1Num,'DISTANCE','GLOBAL');
 
  CurObj   := Objects@O1Name;
  CurPoint := (CurObj.Points)@P1Num;
  CurInf   := (CurPoint.Influences)@InfNum;
 
  CurInf.Parm1 := Dist;
  CurInf.Parm2 := Strngth;
  CurInf.Vec1  := Vec;
 
  (CurPoint.Influences)@InfNum := CurInf;
  (CurObj.Points)@P1Num        := CurPoint;
  Objects@O1Name               := CurObj;
 
};
 
add_defaults('SETDISTANCE','sref,float,vec=(0,0,0),float,float=1');
 
/*---------------------------------------------------------------------*/
 
{ 'SETDISTANCE' function #
  O1Name := ?sref;
  P1Num  := ?float;
  Dist   := ?float;
  Strngth:= ?float;
 
  SetDistance(O1Name,P1Num,Dist,(0,0,0),Strngth);
 
};
 
add_defaults('SETDISTANCE','sref,float,float,float=1');
 
/*---------------------------------------------------------------------*/
 
{ 'SETCONSTRAINT' function #
  OName := ?sref;
  PNum  := ?float;
  Str   := ?float;
  /* Sets the strength Str with which object OName at point PNum is */
  /* affected by the global constraining force */
 
  InfNum := NewInfluence(OName,PNum,'CONSTRAIN','GLOBAL');
 
  CurObj   := Objects@OName;
  CurPoint := (CurObj.Points)@PNum;
  CurInf   := (CurPoint.Influences)@InfNum;
 
  CurInf.Parm1 := Str;
 
  (CurPoint.Influences)@InfNum := CurInf;
  (CurObj.Points)@PNum         := CurPoint;
  Objects@OName                := CurObj;
 
};
 
add_defaults('SETCONSTRAINT','sref, float=0, float=1');
 
/*---------------------------------------------------------------------*/
 
{ 'SETSOLENOID' function #
  OName := ?sref;
  PNum  := ?float;
  Str   := ?float;
  /* Sets the strength Str with which object OName at point PNum is */
  /* affected by the global constraining force */
 
  InfNum := NewInfluence(OName,PNum,'SOLENOID','GLOBAL');
 
  CurObj   := Objects@OName;
  CurPoint := (CurObj.Points)@PNum;
  CurInf   := (CurPoint.Influences)@InfNum;
 
  CurInf.Parm1 := Str;
 
  (CurPoint.Influences)@InfNum := CurInf;
  (CurObj.Points)@PNum         := CurPoint;
  Objects@OName                := CurObj;
 
};
 
