  NewObject('focus',0.7,0.7);  /* a lot of damping */
 
  SetActive('camera',Start,100000);
  SetActive('focus',Start,100000);
 
  dummy:= NewPoint('camera', (0,0,0), 0.1, 0.1); /* radius 0.1 */
  dummy:= NewPoint('focus', (0,0,0), 0.1, 0);    /* radius 0 */
 
