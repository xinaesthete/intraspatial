/*---------------------------------------------------------------------*/
 
{ 'NEWLOBJECT' function #
  ObjName    := ?sref;
  NoOfPoints := ?float;
  LinDamp    := ?float;
  AngDamp    := ?float;
  Denisity   := ?float;
  /* creates a new object of type suitable for use by lifecycl */
  /* i.e. a six point approximation object */
 
  if DanceTrace>=2 then say 'Creating Dancer Object for ' ObjName;
 
  NewObj:= DefFullObj;
  NewObj.LinDamp:= LinDamp;
  NewObj.AngDamp:= AngDamp;
  NewObj.UsesDancerApprox:= true;
 
  Objects@ObjName:= NewObj;
 
  /* create the points for a standard lifecycl object */
  i := 0;
  do(i, 1, NoOfPoints,
   dummy:= NewPoint(ObjName, (0,0,0), 1, 1);
   SetCollision(ObjName,i,1);
   );
 
};
 
