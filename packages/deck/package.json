{
  "name": "@intraspatial/deck",
  "version": "0.1.0",
  "type": "module",
  "description": "deck.gl layers over IntraSpatial's GPU compute: density fields drawn on the device that computed them (WebGPU).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinaesthete/intraspatial.git",
    "directory": "packages/deck"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@intraspatial/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/guarded.mjs -- tsc -p tsconfig.build.json && node ../../scripts/fix-esm-specifiers.mjs dist",
    "typecheck": "node ../../scripts/guarded.mjs -- tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "intraspatial": "workspace:^"
  },
  "peerDependencies": {
    "@deck.gl/core": "~9.4.0",
    "@luma.gl/core": "~9.4.2",
    "@luma.gl/engine": "~9.4.2",
    "@luma.gl/shadertools": "~9.4.2",
    "typegpu": "catalog:"
  },
  "devDependencies": {
    "@deck.gl/core": "~9.4.0",
    "@luma.gl/core": "~9.4.2",
    "@luma.gl/engine": "~9.4.2",
    "@luma.gl/shadertools": "~9.4.2",
    "@luma.gl/webgpu": "~9.4.2",
    "@types/node": "^22.0.0",
    "@webgpu/types": "^0.1.40",
    "typegpu": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
